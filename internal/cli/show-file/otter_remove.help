{2}╭──────────────────────────────────────────────────────────╮{R}
{2}│{R}{1}⦿ Remove otter managed container environments             {R}{2}│{R}
{2}├──────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                                  {2}│{R}
{2}│{R}  {5}otter rm     [options] [container...]{R}                   {2}│{R}
{2}│{R}  {5}otter remove [options] [container...]{R}                   {2}│{R}
{2}├──────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                                               {2}│{R}
{2}│{R}  {5}otter rm --force my-box{R}                                 {2}│{R}
{2}│{R}  {5}otter rm --all --force{R}                                  {2}│{R}
{2}│{R}  {5}otter remove my-box my-box2,my-box3{R}                     {2}│{R}
{2}│{R}  {5}otter remove --all --root --force --rm-home{R}             {2}│{R}
{2}├──────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                                                {2}│{R}
{2}│{R} {4}--all{R}     {2}┆{R} {4}-a{R}  {5}Delete all otters{R}                        {2}│{R}
{2}│{R} {4}--yes{R}     {2}┆{R} {4}-y{R}  {5}Non-interactive, skip confirmations{R}      {2}│{R}
{2}│{R} {4}--root{R}    {2}┆{R} {4}-r{R}  {5}Launch container with root privileges{R}    {2}│{R}
{2}│{R} {4}--force{R}   {2}┆{R} {4}-f{R}  {5}Force deletion of problematic containers{R} {2}│{R}
{2}│{R} {4}--rm-home{R}       {5}Remove container's custom home directory{R} {2}│{R}
{2}│{R} {4}--bypass-lock{R}   {5}Remove container even if it is locked{R}    {2}│{R}
{2}├──────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                                                 {2}│{R}
{2}│{R} {4}--help{R}    {2}┆{R} {4}-h{R}  {5}Show this help message{R}                   {2}│{R}
{2}├───────────┴──────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Notes:{R}                                                  {2}│{R}
{2}│{R} {4}--root{R}  {5}Prefer over 'sudo otter'.{R}                        {2}│{R}
{2}│{R}         {5}Set OTR_SUDO_PROGRAM to use a different program.{R} {2}│{R}
{2}├──────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ See also:{R}                                               {2}│{R}
{2}│{R} {5}Rootful containers need '--root' to work with 'remove' .{R} {2}│{R}
{2}│{R} {5}Locked containers are skipped. Use 'otter unlock' first.{R} {2}│{R}
{2}│{R} {5}Use '--bypass-lock' to remove locked/borked containers. {R} {2}│{R}
{2}╰──────────────────────────────────────────────────────────╯{R}
