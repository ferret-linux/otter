{2}╭─────────────────────────────────────────────────╮{R}
{2}│{R}{1}⦿ Show logs of an otter managed container        {R}{2}│{R}
{2}├─────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                         {2}│{R}
{2}│{R}  {5}otter logs    [options] [container]{R}            {2}│{R}
{2}│{R}  {5}otter journal [options] [container]{R}            {2}│{R}
{2}├─────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                                      {2}│{R}
{2}│{R}  {5}otter logs my-box --follow{R}                     {2}│{R}
{2}│{R}  {5}otter logs my-box --tail 50 --timestamps{R}       {2}│{R}
{2}│{R}  {5}otter journal my-box{R}                           {2}│{R}
{2}│{R}  {5}otter journal my-box --since 1h --timestamps{R}   {2}│{R}
{2}├─────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                                       {2}│{R}
{2}│{R} {4}--tail{R}       {2}┆{R} {4}-n{R}  {5}Show last N lines{R}            {2}│{R}
{2}│{R} {4}--since{R}      {2}┆{R} {4}-s{R}  {5}Show logs since duration {R}    {2}│{R}
{2}│{R} {4}--until{R}      {2}┆{R} {4}-u{R}  {5}Show logs until duration {R}    {2}│{R}
{2}│{R} {4}--follow{R}     {2}┆{R} {4}-f{R}  {5}Stream logs live{R}             {2}│{R}
{2}│{R} {4}--timestamps{R} {2}┆{R} {4}-t{R}  {5}Show timestamps on each line{R} {2}│{R}
{2}├─────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                                        {2}│{R}
{2}│{R} {4}--root{R}       {2}┆{R} {4}-r{R}  {5}View logs of a rootful container{R} {2}│{R}
{2}│{R} {4}--help{R}       {2}┆{R} {4}-h{R}  {5}Show this help message{R}       {2}│{R}
{2}├─────────────┴───────────────────────────────────┤{R}
{2}│{R}{3}▸ Notes:{R}                                         {2}│{R}
{2}│{R} {5}Alias: 'otter logs' works identically.{R}          {2}│{R}
{2}│{R} {5}--since/--until accept: 30s, 15m, 2h, 1h30m{R}     {2}│{R}
{2}│{R} {5}or absolute timestamps e.g. 2026-05-01T00:00:00{R} {2}│{R}
{2}╰─────────────────────────────────────────────────╯{R}
