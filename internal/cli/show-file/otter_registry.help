{2}│{R}{1}⦿ Browse and manage otter images from the registry            {R}{2}│{R}
{2}├──────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                                      {2}│{R}
{2}│{R}  {5}otter registry  [options]{R}                                   {2}│{R}
{2}│{R}  {5}otter hub       [options]{R}                                   {2}│{R}
{2}│{R}  {5}otter hub pull   [options]{R}                                  {2}│{R}
{2}│{R}  {5}otter hub remove [options]{R}                                  {2}│{R}
{2}├──────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                                                   {2}│{R}
{2}│{R}  {5}otter registry{R}                                              {2}│{R}
{2}│{R}  {5}otter registry --all{R}                                        {2}│{R}
{2}│{R}  {5}otter hub pull -n ubuntu{R}                                    {2}│{R}
{2}│{R}  {5}otter hub pull -n ubuntu,fedora,kali{R}                        {2}│{R}
{2}│{R}  {5}otter hub pull --all{R}                                        {2}│{R}
{2}│{R}  {5}otter hub pull --all --force{R}                                {2}│{R}
{2}│{R}  {5}otter hub remove -n ubuntu{R}                                  {2}│{R}
{2}│{R}  {5}otter hub remove --all --force{R}                              {2}│{R}
{2}├──────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ registry / hub:{R}                                             {2}│{R}
{2}│{R} {4}--all{R}     {2}┆{R} {4}-a{R}  {5}Include disabled images in the table{R}         {2}│{R}
{2}├──────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ hub pull / get:{R}                                             {2}│{R}
{2}│{R} {4}--name{R}    {2}┆{R} {4}-n{R}  {5}Image name(s), repeatable or comma-separated{R} {2}│{R}
{2}│{R} {4}--all{R}     {2}┆{R} {4}-a{R}  {5}Pull all enabled images not yet present{R}      {2}│{R}
{2}│{R} {4}--force{R}   {2}┆{R} {4}-f{R}  {5}Pull even if image already present locally{R}   {2}│{R}
{2}├──────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ hub remove / rm:{R}                                            {2}│{R}
{2}│{R} {4}--name{R}    {2}┆{R} {4}-n{R}  {5}Image name(s), repeatable or comma-separated{R} {2}│{R}
{2}│{R} {4}--all{R}     {2}┆{R} {4}-a{R}  {5}Remove all locally present otter images{R}      {2}│{R}
{2}│{R} {4}--force{R}   {2}┆{R} {4}-f{R}  {5}Remove even if image is in use{R}               {2}│{R}
