{2}│{R}{1}⦿ Upgrade packages inside otter managed containers {R}{2}│{R}
{2}├───────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                           {2}│{R}
{2}│{R}  {5}otter syu     [options] [container...]{R}           {2}│{R}
{2}│{R}  {5}otter upgrade [options] [container...]{R}           {2}│{R}
{2}├───────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                                        {2}│{R}
{2}│{R}  {5}otter syu my-box{R}                                 {2}│{R}
{2}│{R}  {5}otter syu --all --root{R}                           {2}│{R}
{2}│{R}  {5}otter upgrade --all{R}                              {2}│{R}
{2}│{R}  {5}otter upgrade --running{R}                          {2}│{R}
{2}├───────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                                         {2}│{R}
{2}│{R} {4}--all{R}     {2}┆{R} {4}-a{R}  {5}Perform for all otters{R}            {2}│{R}
{2}│{R} {4}--root{R}    {2}┆{R} {4}-r{R}  {5}Upgrade rootful containers{R}        {2}│{R}
{2}│{R} {4}--running{R} {2}┆{R} {4}-R{R}  {5}Only upgrade running containers{R}   {2}│{R}
{2}├───────────┴───────────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                                          {2}│{R}
