{2}╭─────────────────────────────────────────────────────────────────────────────────────╮{R}
{2}│{R}{1}⦿ Create native distro like container environments using otter                       {R}{2}│{R}
{2}├─────────────────────────────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                                                             {2}│{R}
{2}│{R}  {5}otter mk --init --nvidia --root{R}                                                    {2}│{R}
{2}│{R}  {5}otter mk --clone my-box --name my-copy{R}                                             {2}│{R}
{2}│{R}  {5}otter mk --image alpine --name my-alpinebox{R}                                        {2}│{R}
{2}│{R}  {5}otter mk --init --additional-flags "--pids-limit 100"{R}                              {2}│{R}
{2}│{R}  {5}otter mk --init --volume /opt/my-dir:/usr/local/my-dir:rw{R}                          {2}│{R}
{2}│{R}  {5}otter create --image centos:stream10 --pull --home ~/otter/centos10{R}                {2}│{R}
{2}│{R}  {5}otter create --image alpine:latest --additional-packages "git tmux vim"{R}            {2}│{R}
{2}│{R}  {5}otter create --image rocky --pre-init-hooks "rpm -qa | wc -l"{R}                      {2}│{R}
{2}│{R}  {5}otter create --image registry.fedoraproject.org/fedora-toolbox:latest{R}              {2}│{R}
{2}│{R}  {5}otter create --image alpine:latest --init-hooks "touch /tmp/test1 && touch grass"{R}  {2}│{R}
{2}├─────────────────────────────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                                                                           {2}│{R}
{2}│{R} {4}--yes{R}                 {2}┆{R} {4}-Y{R}   {5}Non-interactive, pull images without asking{R}            {2}│{R}
{2}│{R} {4}--home{R}                {2}┆{R} {4}-H{R}   {5}Custom HOME directory for the container{R}                {2}│{R}
{2}│{R} {4}--init{R}                {2}┆{R} {4}-I{R}   {5}Use init system (e.g. systemd) inside the container{R}    {2}│{R}
{2}│{R} {4}--name{R}                {2}┆{R} {4}-n{R}   {5}Name for the container{R}                                 {2}│{R}
{2}│{R} {4}--pull{R}                {2}┆{R} {4}-p{R}   {5}Pull image even if it exists locally (implies --yes){R}   {2}│{R}
{2}│{R} {4}--root{R}                {2}┆{R} {4}-r{R}   {5}Launch container manager with root privileges{R}          {2}│{R}
{2}│{R} {4}--clone{R}               {2}┆{R} {4}-c{R}   {5}Name of container to use as base for new container{R}     {2}│{R}
{2}│{R} {4}--image{R}               {2}┆{R} {4}-i{R}   {5}Image to use for the container{R}                         {2}│{R}
{2}│{R} {4}--shell{R}               {2}┆{R} {4}-s{R}   {5}Shell to use inside the container{R}                      {2}│{R}
{2}│{R} {4}--memory{R}          {5}           Memory limit for the container (e.g. 512m, 2g){R}         {2}│{R}
{2}│{R} {4}--nvidia{R}          {5}           Integrate host's Nvidia drivers into container{R}         {2}│{R}
{2}│{R} {4}--volume{R}          {5}           Additional volumes to add to the container{R}             {2}│{R}
{2}│{R} {4}--hostname{R}        {5}           Hostname for the container{R}                             {2}│{R}
{2}│{R} {4}--no-entry{R}        {5}           Do not generate a container entry on host system{R}       {2}│{R}
{2}│{R} {4}--platform{R}        {5}           Specify the target platform, e.g. linux/arm64{R}          {2}│{R}
{2}│{R} {4}--init-hooks{R}      {5}           Commands to run at end of container initialization{R}     {2}│{R}
{2}│{R} {4}--cpu-threads{R}     {5}           Number of CPU threads the container can use{R}            {2}│{R}
{2}│{R} {4}--unshare-ipc{R}     {5}           Do not share IPC namespace with host{R}                   {2}│{R}
{2}│{R} {4}--unshare-all{R}     {5}           Activate all unshare flags{R}                             {2}│{R}
{2}│{R} {4}--unshare-netns{R}       {5}       Do not share net namespace with host{R}                   {2}│{R}
{2}│{R} {4}--pre-init-hooks{R}      {5}       Commands to run at start of container initialization{R}   {2}│{R}
{2}│{R} {4}--unshare-groups{R}      {5}       Do not forward user's additional groups into container{R} {2}│{R}
{2}│{R} {4}--unshare-devsys{R}      {5}       Do not share host devices and sysfs dirs{R}               {2}│{R}
{2}│{R} {4}--unshare-process{R}     {5}       Do not share process namespace with host{R}               {2}│{R}
{2}│{R} {4}--additional-flags{R}    {2}┆{R} {4}-a{R}   {5}Additional flags to pass to the container manager{R}      {2}│{R}
{2}│{R} {4}--additional-packages{R} {2}┆{R} {4}-ap{R}  {5}Additional packages to install during container setup{R}  {2}│{R}
{2}├───────────────────────┴─────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                                                                            {2}│{R}
{2}│{R} {4}--help{R}    {2}┆{R} {4}-h{R}  {5}Show this help message{R}                                              {2}│{R}
{2}│{R} {4}--verbose{R} {2}┆{R} {4}-v{R}  {5}Show more verbose output{R}                                            {2}│{R}
{2}│{R} {4}--dry-run{R} {2}┆{R} {4}-d{R}  {5}Print the generated container manager command{R}                       {2}│{R}
{2}│{R} {4}--absolutely-disable-root-password-i-am-really-positively-sure{R}          {5} {R}           {2}│{R}
{2}├─────────────────────────────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Notes:{R}                                                                             {2}│{R}
{2}│{R} {4}--root{R}    {5}Preferred over 'sudo otter' when root is needed. To use a program{R}         {2}│{R}
{2}│{R}           {5}other than sudo, set OTR_SUDO_PROGRAM or 'otter_sudo_program' config var.{R} {2}│{R}
{2}│{R}                                                                                     {2}│{R}
{2}│{R} {4}--init{R}    {5}Makes host processes not visible from within the container, assumes{R}       {2}│{R}
{2}│{R}           {5}--unshare-process. May require additional packages depending on the image{R} {2}│{R}
{2}│{R}           {5},like systemd, runit or openrc.{R}                                           {2}│{R}
{2}│{R}                                                                                     {2}│{R}
{2}│{R} {4}--clone{R}   {5}Useful to rename an existing container or create multiple copies of the{R}   {2}│{R}
{2}│{R}           {5}same container environment.{R}                                               {2}│{R}
{2}│{R}                                                                                     {2}│{R}
{2}│{R} {4}--nvidia{R}  {5}Best effort attempt to integrate host nvidia drivers into the container.{R}  {2}│{R}
{2}│{R}           {5}For a better experience consider nvidia's nvidia-container-toolkit,{R}       {2}│{R}
{2}│{R}           {5}the official way to use nvidia cards inside containers.{R}                   {2}│{R}
{2}├─────────────────────────────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Compatibility:{R}                                                                     {2}│{R}
{2}│{R}  {5}For a list of compatible images run:{R}                                               {2}│{R}
{2}│{R}  {5}otter create --compatibility{R}                                                       {2}│{R}
{2}│{R}  {5}otter create --image typo{R}                                                          {2}│{R}
{2}╰─────────────────────────────────────────────────────────────────────────────────────╯{R}
