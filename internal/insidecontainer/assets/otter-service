def _error(message):
    print(f"ERROR: {message}\n", file=sys.stderr)
    print(render_help(HELP_TEXT))
    sys.exit(1)


def _exec(argv):
    try:
        os.execvp(argv[0], argv)
    except FileNotFoundError as exc:
        print(f"otter-service: {exc.filename}: No such file or directory", file=sys.stderr)
        sys.exit(127)


def _fs_op(action, ok_message, fail_message, func):
    try:
        func()
    except OSError as exc:
        print(f"otter-service: {fail_message}: {exc}", file=sys.stderr)
        sys.exit(1)
    print(ok_message)
    sys.exit(0)


def dispatch(initsystem, action, name):
    if initsystem == "systemd":
        _exec(["systemctl", action, name])
    elif initsystem == "openrc":
        if action in ("enable", "disable"):
            tool = "add" if action == "enable" else "del"
            _exec(["rc-update", tool, name])
        else:
            _exec(["rc-service", name, action])
    elif initsystem == "sysvinit-lsb":
        if action in ("enable", "disable"):
            _exec(["update-rc.d", name, action])
        else:
            _exec([f"/etc/init.d/{name}", action])
    elif initsystem == "sysvinit-bsd":
        rc_script = f"/etc/rc.d/rc.{name}"
        if action == "enable":
            _fs_op(
                action,
                f"'{name}' enabled.\nOK!",
                f"cannot enable '{name}'",
                lambda: os.chmod(rc_script, 0o755),
            )
        elif action == "disable":
            _fs_op(
                action,
                f"'{name}' disabled.\nOK!",
                f"cannot disable '{name}'",
                lambda: os.chmod(rc_script, 0o644),
            )
        else:
            _exec([rc_script, action])
    elif initsystem == "runit":
        service_link = f"/var/service/{name}"
        if action == "enable":
            _fs_op(
                action,
                f"'{name}' enabled.\nOK!",
                f"cannot enable '{name}'",
                lambda: os.symlink(f"/etc/sv/{name}", service_link),
            )
        elif action == "disable":
            _fs_op(
                action,
                f"'{name}' disabled.\nOK!",
                f"cannot disable '{name}'",
                lambda: os.remove(service_link),
            )
        else:
            _exec(["sv", action, service_link])
    elif initsystem == "dinit":
        _exec(["dinitctl", action, name])


if len(sys.argv) < 2 or sys.argv[1] in ("--help", "-h"):
    print(render_help(HELP_TEXT))
    sys.exit(0)

if sys.argv[1] in ("--version", "-V"):
    print(f"otter: {VERSION}")
    sys.exit(0)

if len(sys.argv) != 3:
    _error("usage: otter service <action> <name>")

action, name = sys.argv[1], sys.argv[2]

if action not in ACTIONS:
    _error(f"unknown action '{action}'. Must be one of: {', '.join(ACTIONS)}")

initsystem_marker = Path(f"{MARKERS_DIR}/container.initsystem")
if not initsystem_marker.is_file():
    print(
        "bro your container is maidenless ( initless ) like you , this command aint gonna work on it"
    )
    sys.exit(0)

initsystem = initsystem_marker.read_text().strip()

if initsystem == "generic":
    print(
        "bro , I aint doing a generic implementation , use any of the above/supported init systems for gods sake",
        file=sys.stderr,
    )
    sys.exit(1)

dispatch(initsystem, action, name)