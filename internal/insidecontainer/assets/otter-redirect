def _error(message):
    print(f"ERROR: {message}\n", file=sys.stderr)
    print(render_help(HELP_TEXT))
    sys.exit(1)


def redirect_path(name):
    return Path(REDIRECT_DIR) / name


def generate_wrapper(args_list, host_cmd_raw):
    quoted = " ".join(shlex.quote(a) for a in args_list)
    return f"""#!/bin/sh
{MARKER_LINE}
# host-cmd: {host_cmd_raw}
exec otter-host-exec {quoted} "$@"
"""


def add_redirect(host_cmd, as_name):
    if not host_cmd:
        _error("--host-cmd is required.")

    args_list = shlex.split(host_cmd)
    if not args_list:
        _error("--host-cmd cannot be empty.")

    if as_name:
        name = as_name
    elif len(args_list) == 1:
        name = args_list[0]
    else:
        _error("--as is required when --host-cmd is more than one word.")

    if shutil.which(name):
        print(f"Error: '{name}' already resolves to a real binary; refusing to overwrite.", file=sys.stderr)
        print(f"Error: remove it first with 'otter redirect remove {name}' if you want to redefine it.", file=sys.stderr)
        return 1

    dest_file = redirect_path(name)

    try:
        dest_file.write_text(generate_wrapper(args_list, host_cmd))
        dest_file.chmod(0o755)
    except OSError as exc:
        print(f"Error: cannot create {dest_file}: {exc}", file=sys.stderr)
        return 1

    print(f"'{name}' now redirects to '{host_cmd}' on the host.\nOK!")
    return 0


def remove_redirect(name):
    dest_file = redirect_path(name)

    if not dest_file.is_file():
        print(f"Error: '{name}' is not a redirect.", file=sys.stderr)
        return 1

    try:
        content = dest_file.read_text()
    except OSError as exc:
        print(f"Error: cannot read {dest_file}: {exc}", file=sys.stderr)
        return 1

    if MARKER_LINE not in content:
        print(f"Error: '{name}' is not a redirect.", file=sys.stderr)
        return 1

    try:
        dest_file.unlink()
    except OSError as exc:
        print(f"Error: cannot remove {dest_file}: {exc}", file=sys.stderr)
        return 1

    print(f"'{name}' redirect removed.\nOK!")
    return 0


def list_redirects():
    try:
        entries = sorted(Path(REDIRECT_DIR).iterdir())
    except OSError:
        entries = []

    for entry in entries:
        if not entry.is_file():
            continue
        try:
            content = entry.read_text(errors="replace")
        except OSError:
            continue
        if MARKER_LINE not in content:
            continue
        host_cmd = ""
        for line in content.splitlines():
            if line.startswith("# host-cmd: "):
                host_cmd = line[len("# host-cmd: "):]
                break
        print(f"{entry.name:<20} | {host_cmd}")

    return 0


if len(sys.argv) < 2 or sys.argv[1] in ("--help", "-h"):
    print(render_help(HELP_TEXT))
    sys.exit(0)

if sys.argv[1] in ("--version", "-V"):
    print(f"otter: {VERSION}")
    sys.exit(0)

action = sys.argv[1]
remaining = sys.argv[2:]

if action == "add":
    parser = argparse.ArgumentParser(add_help=False)
    parser.error = _error
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("-c", "--host-cmd", dest="host_cmd", default="")
    parser.add_argument("-n", "--as", dest="as_name", default="")
    args = parser.parse_args(remaining)

    if args.help:
        print(render_help(HELP_TEXT))
        sys.exit(0)

    sys.exit(add_redirect(args.host_cmd, args.as_name))
elif action == "remove":
    if not remaining or remaining[0] in ("-h", "--help"):
        print(render_help(HELP_TEXT))
        sys.exit(0)
    if len(remaining) != 1:
        _error("remove takes exactly one argument: the redirect name.")
    sys.exit(remove_redirect(remaining[0]))
elif action == "list":
    if remaining and remaining[0] in ("-h", "--help"):
        print(render_help(HELP_TEXT))
        sys.exit(0)
    sys.exit(list_redirects())
else:
    print(f"ERROR: unknown command '{action}'\n", file=sys.stderr)
    print(render_help(HELP_TEXT))
    sys.exit(1)