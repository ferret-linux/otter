import os
import sys

SCRIPTS_DIR = "/usr/lib/otter/scripts"
VERSION     = "0.0.9"

def render_help(text):
    color_green  = "\033[32m"
    color_teal   = "\033[96m"
    color_cyan   = "\033[36m"
    color_yellow = "\033[33m"
    color_blue   = "\033[34m"
    color_dim    = "\033[37m"
    slots = [color_green, color_teal, color_cyan, color_yellow, color_blue, color_dim]
    if os.environ.get("NO_COLOR") is not None or os.environ.get("TERM") == "dumb":
        for i in range(len(slots)):
            text = text.replace(f"{{{i}}}", "")
        return text.replace("{R}", "")
    for i, code in enumerate(slots):
        text = text.replace(f"{{{i}}}", code)
    return text.replace("{R}", "\033[0m")

HELP_TEXT = """\
{2}╭───────────────────────────────────────────────────────╮{R}
{2}│{R}{1}⦿ Use any Linux distribution inside your terminal{R}      {2}│{R}
{2}├───────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                               {2}│{R}
{2}│{R}  {5}otter <command> [args]{R}                               {2}│{R}
{2}├───────────────────────────────────────────────────────┤{R}
{2}│{R}{1}● Commands ➜{R}                                           {2}│{R}
{2}│{R}{3}▸ Host Integration:{R}                                    {2}│{R}
{2}│{R} {4}export{R}    {2}┆{R} {4}ex{R}  {5}Export apps or binaries to the host{R}   {2}│{R}
{2}│{R} {4}redirect{R}  {2}┆{R} {4}rd{R}  {5}Redirect a command to run on the host{R} {2}│{R}
{2}│{R} {4}host-exec{R} {2}┆{R} {4}hex{R} {5}Run a command on the host from otter{R}  {2}│{R}
{2}│{R}{3}▸ Health & Management:{R}                                 {2}│{R}
{2}│{R} {4}doctor{R}    {2}┆{R} {4}dr{R}  {5}Diagnose the container's health{R}       {2}│{R}
{2}│{R} {4}service{R}   {2}┆{R} {4}svc{R} {5}Manage a service inside the container{R} {2}│{R}
{2}├───────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                                              {2}│{R}
{2}│{R} {4}--help{R}    {2}┆{R} {4}-h{R}  {5}Show this help message{R}                {2}│{R}
{2}│{R} {4}--version{R} {2}┆{R} {4}-V{R}  {5}Show version information{R}              {2}│{R}
{2}╰───────────────────────────────────────────────────────╯{R}"""

if len(sys.argv) < 2 or sys.argv[1] in ("--help", "-h"):
    print(render_help(HELP_TEXT))
    sys.exit(0)

if sys.argv[1] in ("--version", "-V"):
    print(f"otter: {VERSION}")
    sys.exit(0)

subcommand = sys.argv[1]
remaining  = sys.argv[2:]

if subcommand in ("export", "ex"):
    os.execv(f"{SCRIPTS_DIR}/otter-export", ["otter-export"] + remaining)
elif subcommand in ("redirect", "rd"):
    os.execv(f"{SCRIPTS_DIR}/otter-redirect", ["otter-redirect"] + remaining)
elif subcommand in ("host-exec", "hex"):
    os.execv(f"{SCRIPTS_DIR}/otter-host-exec", ["otter-host-exec"] + remaining)
elif subcommand in ("doctor", "dr"):
    os.execv(f"{SCRIPTS_DIR}/otter-doctor", ["otter-doctor"] + remaining)
elif subcommand in ("service", "svc"):
    os.execv(f"{SCRIPTS_DIR}/otter-service", ["otter-service"] + remaining)
else:
    print(f"ERROR: unknown command '{subcommand}'\n", file=sys.stderr)
    print(render_help(HELP_TEXT))
    sys.exit(1)
