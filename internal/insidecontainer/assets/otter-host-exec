import argparse
import os
import platform
import re
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path
from pwd import getpwnam

# Ensure env variables are correctly set
if not os.environ.get("USER"):
    os.environ["USER"] = subprocess.run(["id", "-run"], capture_output=True, text=True).stdout.strip()
if not os.environ.get("HOME"):
    os.environ["HOME"] = getpwnam(os.environ["USER"]).pw_dir
if not os.environ.get("SHELL"):
    os.environ["SHELL"] = getpwnam(os.environ["USER"]).pw_shell

# Defaults
HOST_SPAWN_VERSION = "v1.6.2"
VERSION = "0.0.9"

try:
    os.ttyname(sys.stdout.fileno())
    non_interactive = not sys.stdout.isatty()
except OSError:
    non_interactive = True
host_command = ""

# If we're a symlink to a command, use that as the command to exec
if os.path.basename(sys.argv[0]) != "otter-host-exec":
    host_command = os.path.basename(sys.argv[0])

def render_help(text):
    color_green  = "\033[32m"  # {0} green  — command names
    color_teal   = "\033[96m"  # {1} teal   — tagline/messages
    color_cyan   = "\033[36m"  # {2} cyan   — box borders
    color_yellow = "\033[33m"  # {3} yellow — headers (▸ Section:)
    color_blue   = "\033[34m"  # {4} blue   — flags/extras
    color_dim    = "\033[37m"  # {5} dim    — descriptions/info text
    # {R} resets color
    slots = [color_green, color_teal, color_cyan, color_yellow, color_blue, color_dim]
    if os.environ.get("NO_COLOR") is not None or os.environ.get("TERM") == "dumb":
        for i in range(len(slots)):
            text = text.replace(f"{{{i}}}", "")
        return text.replace("{R}", "")
    for i, code in enumerate(slots):
        text = text.replace(f"{{{i}}}", code)
    return text.replace("{R}", "\033[0m")

HELP_TEXT = """\
{2}╭─────────────────────────────────────────────────╮{R}
{2}│{R}{3}▸ Usage:{R}                                         {2}│{R}
{2}│{R}  {5}otter host-exec [options] <command> [args]{R}     {2}│{R}
{2}├─────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                                      {2}│{R}
{2}│{R}  {5}otter host-exec ls{R}                             {2}│{R}
{2}│{R}  {5}otter host-exec bash -l{R}                        {2}│{R}
{2}│{R}  {5}otter host-exec podman ps -a{R}                   {2}│{R}
{2}│{R}  {5}otter host-exec flatpak remotes{R}                {2}│{R}
{2}├─────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                                       {2}│{R}
{2}│{R} {4}--yes{R} {2}┆{R} {4}-Y{R}  {5}Automatic host-spawn installation{R}   {2}│{R}
{2}├─────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                                        {2}│{R}
{2}│{R} {4}--help{R}    {2}┆{R} {4}-h{R}  {5}Show this help message{R}          {2}│{R}
{2}│{R} {4}--version{R} {2}┆{R} {4}-V{R}  {5}Show version information{R}        {2}│{R}
{2}├─────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Notes:{R}                                         {2}│{R}
{2}│{R} {4}--yes{R}  {5}Auto-confirmed in non-interactive shells.{R}{2}│{R}
{2}│{R}        {5}When auto confirmed, host-spawn will be{R}  {2}│{R}
{2}│{R}        {5}installed in the container, as{R}           {2}│{R}
{2}│{R}        {5}otter-host-exec needs it to work.{R}        {2}│{R}
{2}╰─────────────────────────────────────────────────╯{R}"""

if not host_command:
    def _parser_error(message):
        print(f"ERROR: {message}\n", file=sys.stderr)
        print(render_help(HELP_TEXT))
        sys.exit(1)

    parser = argparse.ArgumentParser(
        add_help=False,
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.error = _parser_error
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("-V", "--version", action="store_true")
    parser.add_argument("-Y", "--yes", action="store_true")
    parser.add_argument("command", nargs="?", default="")
    parser.add_argument("args", nargs=argparse.REMAINDER)

    args = parser.parse_args()

    if args.help:
        print(render_help(HELP_TEXT))
        sys.exit(0)

    if args.version:
        print(f"otter: {VERSION}")
        print(f"host-spawn: {HOST_SPAWN_VERSION}")
        sys.exit(0)

    if args.yes:
        non_interactive = True

    host_command = args.command
    extra_args = args.args
else:
    extra_args = sys.argv[1:]

# Check we're running inside a container and not on the host
if (
    not Path("/run/.containerenv").is_file()
    and not Path("/.dockerenv").is_file()
    and not os.environ.get("container")
):
    print(f"You must run  {os.path.basename(sys.argv[0])} inside a container!", file=sys.stderr)
    sys.exit(126)

if not host_command:
    host_command = os.environ.get("SHELL", "/bin/sh")

# sudo command detection
sudo_command = []
if os.getresuid()[0] != 0:
    if shutil.which("sudo"):
        sudo_command = ["sudo"]
    else:
        sudo_command = ["su", "-l", "-c"]

# Normalize architecture name to comply to golang/release naming
architecture = platform.machine()
if "armv" in architecture:
    m = re.search(r"armv[0-9]+", architecture)
    if m:
        architecture = m.group(0)

# Setup host-spawn
def get_host_spawn_version():
    try:
        result = subprocess.run(
            ["host-spawn", "--version"],
            capture_output=True, text=True
        )
        return result.stdout.strip()
    except Exception:
        return ""

def version_tuple(v):
    v = v.lstrip("v")
    return tuple(int(x) for x in re.split(r"[.\-]", v) if x.isdigit())

host_spawn_found = bool(shutil.which("host-spawn"))
host_spawn_ok = False
if host_spawn_found:
    installed_ver = get_host_spawn_version()
    host_spawn_ok = version_tuple(installed_ver) >= version_tuple(HOST_SPAWN_VERSION)

if not host_spawn_ok:
    if not non_interactive:
        print("Warning: host-spawn not found or version is too old!")
        print("Do you want to install host-spawn utility? [Y/n] ", end="", flush=True)
        response = input().strip() or "Y"
    else:
        response = "yes"

    if response in ("y", "Y", "Yes", "yes", "YES"):
        url = f"https://github.com/1player/host-spawn/releases/download/{HOST_SPAWN_VERSION}/host-spawn-{architecture}"
        tmp_path = Path("/tmp/host-spawn")
        try:
            urllib.request.urlretrieve(url, tmp_path)
        except Exception:
            print("Error: Cannot download host-spawn", file=sys.stderr)
            sys.exit(1)
        if tmp_path.exists():
            subprocess.run(sudo_command + ["sh", "-c", "mv /tmp/host-spawn /usr/bin/"], check=True)
            subprocess.run(sudo_command + ["sh", "-c", "chmod +x /usr/bin/host-spawn"], check=True)
    elif response in ("n", "N", "No", "no", "NO"):
        print("Installation aborted, please install host-spawn.")
        sys.exit(0)
    else:
        print("Invalid input.", file=sys.stderr)
        print("The available choices are: y,Y,Yes,yes,YES or n,N,No,no,NO.\nExiting.", file=sys.stderr)
        sys.exit(1)

# Point dbus/xdg to host's runtime dir for initful containers
real_uid = int(os.environ["OTTER_HOST_UID"])
xdg = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{real_uid}"
dbus = os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path=/run/user/{real_uid}/bus"

os.environ["XDG_RUNTIME_DIR"] = f"/run/host/{xdg}"
dbus_path = dbus.split("=", 1)[-1]
os.environ["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path=/run/host/{dbus_path}"

# PTY decision — xdg-open, gio, flatpak and non-tty get --no-pty
cmd_basename = os.path.basename(host_command)
try:
    os.ttyname(sys.stdout.fileno())
    tty_ok = sys.stdout.isatty()
except OSError:
    tty_ok = False

no_pty = (
    cmd_basename in ("xdg-open", "gio", "flatpak")
    or not tty_ok
)

if no_pty:
    os.execvp("host-spawn", ["host-spawn", "--no-pty", host_command] + extra_args)
else:
    os.execvp("host-spawn", ["host-spawn", host_command] + extra_args)
