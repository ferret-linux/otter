def _parser_error(message):
    print(f"ERROR: {message}\n", file=sys.stderr)
    print(render_help(HELP_TEXT))
    sys.exit(1)

parser = argparse.ArgumentParser(add_help=False)
parser.error = _parser_error
parser.add_argument("-h", "--help",         action="store_true")
parser.add_argument("-V", "--version",      action="store_true")
parser.add_argument("-a", "--app",          dest="exported_app",   default="")
parser.add_argument("-b", "--bin",          dest="exported_bin",   default="")
parser.add_argument("-n", "--as",           dest="exported_as",    default="")
parser.add_argument("-S", "--sudo",         action="store_true",   dest="is_sudo")
parser.add_argument("-del", "--delete",     action="store_true",   dest="exported_delete")
parser.add_argument("--list-apps",          action="store_true")
parser.add_argument("--list-binaries",      action="store_true")
parser.add_argument("-el", "--export-label", dest="exported_app_label", default="")
parser.add_argument("-ep", "--export-path",  dest="dest_path",     default=dest_path)
parser.add_argument("-ef", "--extra-flags",  dest="extra_flags",   default="")
parser.add_argument("-nf", "--enter-flags",  dest="enter_flags",   default="")

args = parser.parse_args()

if args.help:
    print(render_help(HELP_TEXT))
    sys.exit(0)
if args.version:
    print(f"otter: {VERSION}")
    sys.exit(0)

exported_app     = args.exported_app
exported_bin     = args.exported_bin
exported_as      = args.exported_as
is_sudo          = args.is_sudo
exported_delete  = args.exported_delete
exported_app_label = args.exported_app_label
dest_path        = args.dest_path
extra_flags      = args.extra_flags
enter_flags      = args.enter_flags

# dest_path is the export destination as a *host* path — it's what
# generate_script() embeds for otter-host-exec (which runs on the real
# host, where /run/host doesn't exist) and what we show the user in
# messages. Any actual filesystem I/O from inside the container must go
# through the /run/host mirror instead: on a custom-home container the
# real host home is bind-mounted only at /run/host<path>, not at its own
# literal path, so writing to the bare dest_path silently lands in the
# container's own ephemeral filesystem instead of the real host directory.
dest_path_container = f"/run/host{dest_path}"

if args.list_apps:
    export_action = "list-apps"
elif args.list_binaries:
    export_action = "list-binaries"
elif exported_app:
    export_action = "app"
elif exported_bin:
    export_action = "bin"

# Ensure we can write stuff there
Path(dest_path_container).mkdir(parents=True, exist_ok=True)

# Check we're running inside a container and not on the host
if (
    not Path("/run/.containerenv").is_file()
    and not Path("/.dockerenv").is_file()
    and not os.environ.get("container")
):
    print(f"You must run  {os.path.basename(sys.argv[0])} inside a container!", file=sys.stderr)
    sys.exit(126)

# Check if we're in a rootful or rootless container
if Path("/usr/lib/otter/container.rootful").is_file():
    rootful = "--root"

# We're working with HOME, so we must run as USER, not as root
if os.getuid() == 0:
    print(f"You must not run  {os.path.basename(sys.argv[0])} as root!", file=sys.stderr)
    sys.exit(1)

# Ensure we're not receiving more than one action at a time
if exported_app and exported_bin:
    print("Error: Invalid arguments, choose only one action below.", file=sys.stderr)
    print("Error: You can only export one thing at time.", file=sys.stderr)
    sys.exit(2)

# Filter enter_flags and remove redundant options
if enter_flags:
    filtered = []
    parts = enter_flags.split()
    j = 0
    while j < len(parts):
        if parts[j] in ("--root", "-r"):
            print(f"Warning: {parts[j]} argument will be set automatically and should be removed.", file=sys.stderr)
        elif parts[j] in ("--name", "-n"):
            print(f"Warning: {parts[j]} argument will be set automatically and should be removed.", file=sys.stderr)
            j += 1  # skip the value too
        else:
            filtered.append(parts[j])
        j += 1
    enter_flags = " ".join(filtered)

# Command to execute
container_command_suffix = f"'{exported_bin}' {extra_flags} \"$@\""

# Check if exported application/binary should be run with sudo privileges
if is_sudo:
    sudo_prefix = "sudo -S"
    result = subprocess.run(["sudo", "-S", "test"], capture_output=True)
    if result.returncode != 0:
        sudo_prefix = "sudo"

    # Edge case for systems with doas
    if shutil.which("doas"):
        sudo_prefix = "doas"
        container_command_suffix = f"sh -l -c \"'{exported_bin}' {extra_flags} $@\""

    # Edge case for systems without sudo
    if shutil.which("su-exec"):
        sudo_prefix = "su-exec root"
        container_command_suffix = f"sh -l -c \"'{exported_bin}' {extra_flags} $@\""

# Prefix to add to an existing command to work through the container
otter_path = os.environ.get("OTTER_PATH", "otter")
_rootful_part = f" {rootful}" if rootful else ""
_enter_flags_part = f" {enter_flags}" if enter_flags else ""
_sudo_part = f" {sudo_prefix}" if sudo_prefix else ""
container_command_prefix = (
    f"{otter_path} enter{_rootful_part} -n {container_name}{_enter_flags_part} --no-tty --{_sudo_part} "
)

if not exported_app_label:
    if rootful:
        exported_app_label = f" (on {container_name}, rootful)"
    else:
        exported_app_label = f" (on {container_name})"
elif exported_app_label == "none":
    exported_app_label = ""
else:
    exported_app_label = f" {exported_app_label}"


def generate_script():
    name_prefix = f"rootful-{container_name}" if rootful else container_name
    return f"""#!/bin/sh
# otter_binary
# name: {name_prefix}
if [ -z "${{CONTAINER_ID}}" ]; then
\texec "{otter_path}" enter {rootful} -n {container_name} {enter_flags} -- {sudo_prefix} {container_command_suffix}
elif [ -n "${{CONTAINER_ID}}" ] && [ "${{CONTAINER_ID}}" != "{container_name}" ]; then
\texec otter-host-exec '{dest_path}/{os.path.basename(exported_bin)}' "$@"
else
\texec {sudo_prefix} '{exported_bin}' "$@"
fi
"""


def export_binary():
    if not Path(exported_bin).is_file():
        print(f"Error: cannot find {exported_bin}.", file=sys.stderr)
        return 127

    bin_suffix = f"rootful-{container_name}" if rootful else container_name
    dest_name = exported_as if exported_as else f"{os.path.basename(exported_bin)}-{bin_suffix}"
    dest_file = Path(dest_path_container) / dest_name

    Path(dest_path_container).mkdir(parents=True, exist_ok=True)

    if exported_delete:
        if "otter_binary" not in dest_file.read_text():
            print(f"Error: {exported_bin} is not exported.", file=sys.stderr)
            return 1
        try:
            dest_file.unlink()
        except OSError:
            return 1
        print(f"{exported_bin} from {container_name} removed successfully from {dest_path}.\nOK!")
        return 0

    if dest_file.exists() and "otter_binary" not in dest_file.read_text():
        print(f"Error: '{dest_name}' already exists at {dest_file} and was not created by otter-export; refusing to overwrite.", file=sys.stderr)
        print(f"Error: use --as to export under a different name.", file=sys.stderr)
        return 1

    try:
        dest_file.touch()
    except OSError:
        print(f"Error: cannot create destination file {dest_file}.", file=sys.stderr)
        return 1

    dest_file.write_text(generate_script())
    dest_file.chmod(0o755)
    print(f"{exported_bin} from {container_name} exported successfully in {dest_path}.\nOK!")
    return 0


def export_application():
    canon_dirs = []

    if Path(exported_app).exists():
        desktop_files = [exported_app]
    else:
        xdg_data_dirs = os.environ.get("XDG_DATA_DIRS", "")
        if xdg_data_dirs:
            for xdg_dir in xdg_data_dirs.split(":"):
                p = Path(xdg_dir) / "applications"
                if p.is_dir():
                    canon_dirs.append(str(p))
        else:
            for d in ["/usr/share/applications", "/usr/local/share/applications",
                      "/var/lib/flatpak/exports/share/applications"]:
                if Path(d).is_dir():
                    canon_dirs.append(d)

        xdg_data_home = os.environ.get("XDG_DATA_HOME", "")
        if xdg_data_home:
            p = Path(xdg_data_home) / "applications"
            if p.is_dir():
                canon_dirs.append(str(p))
        else:
            p = Path(os.environ.get("HOME", "")) / ".local/share/applications"
            if p.is_dir():
                canon_dirs.append(str(p))

        if not canon_dirs:
            print("Error: cannot find any desktop files.", file=sys.stderr)
            print("Error: trying to export a non-installed application.", file=sys.stderr)
            return 127

        # find files matching exported_app in Exec= or Name=, excluding already-exported ones
        find_cmd = ["find"] + canon_dirs + ["-type", "f", "-print", "-o", "-type", "l", "-print"]
        result = subprocess.run(find_cmd, capture_output=True, text=True)
        candidates = [f for f in result.stdout.splitlines() if f]

        otter_path_pat = os.environ.get("OTTER_PATH", "otter")
        matched = []
        for f in candidates:
            try:
                content = Path(f).read_text(errors="replace")
                if (re.search(rf"Exec=.*{re.escape(exported_app)}.*", content) or
                        re.search(rf"Name=.*{re.escape(exported_app)}.*", content)):
                    if not re.search(rf"Exec=.*{re.escape(otter_path_pat)}.*enter.*", content):
                        matched.append(f)
            except OSError:
                pass

        desktop_files = matched

    if not desktop_files:
        print("Error: cannot find any desktop files.", file=sys.stderr)
        print("Error: trying to export a non-installed application.", file=sys.stderr)
        return 127

    # Find the single best icon from the first desktop file
    icon_name = ""
    for df in desktop_files:
        try:
            content = Path(df).read_text(errors="replace")
            m = re.search(r"^Icon=(.+)$", content, re.MULTILINE)
            if m:
                icon_name = m.group(1).strip()
            break
        except OSError:
            pass

    icon_file = ""
    if icon_name:
        if icon_name.startswith("/") and Path(icon_name).exists():
            icon_file = icon_name
        else:
            search_dirs = [
                ("/usr/share/icons/hicolor", f"{icon_name}.svg"),
                ("/var/lib/flatpak/exports/share/icons", f"{icon_name}.svg"),
                ("/usr/share/pixmaps", f"{icon_name}.svg"),
            ]
            for sdir, pattern in search_dirs:
                if not icon_file:
                    r = subprocess.run(
                        ["find", sdir, "-type", "f", "-name", pattern],
                        capture_output=True, text=True
                    )
                    hits = [f for f in r.stdout.splitlines() if "symbolic" not in f]
                    if hits:
                        icon_file = hits[0]

            if not icon_file:
                png_dirs = [
                    "/usr/share/icons/hicolor",
                    "/var/lib/flatpak/exports/share/icons",
                    "/usr/share/pixmaps",
                ]
                for sdir in png_dirs:
                    if not icon_file:
                        r = subprocess.run(
                            ["find", sdir, "-type", "f", "-name", f"{icon_name}.png"],
                            capture_output=True, text=True
                        )
                        hits = sorted(
                            [f for f in r.stdout.splitlines() if "symbolic" not in f],
                            key=lambda p: [int(x) if x.isdigit() else x for x in re.split(r'(\d+)', p)],
                            reverse=True
                        )
                        if hits:
                            icon_file = hits[0]

    icon_dest_dir = f"/run/host{host_home}/.local/share/otter/icons/apps"
    icon_ext = Path(icon_file).suffix.lstrip(".") if icon_file else ""
    icon_prefix = f"rootful-{container_name}" if rootful else container_name
    icon_dest_file = f"{icon_dest_dir}/{icon_prefix}-{icon_name}.{icon_ext}"
    icon_host_path = f"{host_home}/.local/share/otter/icons/apps/{icon_prefix}-{icon_name}.{icon_ext}"

    Path(f"/run/host{host_home}/.local/share/applications").mkdir(parents=True, exist_ok=True)

    for df in desktop_files:
        desktop_prefix = f"rootful-{container_name}" if rootful else container_name
        desktop_home_file = f"{desktop_prefix}-{os.path.basename(df)}"
        dest_desktop = Path(f"/run/host{host_home}/.local/share/applications/{desktop_home_file}")

        if exported_delete:
            dest_desktop.unlink(missing_ok=True)
            Path(icon_dest_file).unlink(missing_ok=True)
            continue

        try:
            content = Path(df).read_text(errors="replace")
        except OSError:
            continue

        # Add command_prefix, extra flags, remove TryExec/DBusActivatable, append label to Name
        content = re.sub(
            r"^Exec=(.*)$",
            lambda m: f"Exec={container_command_prefix}{m.group(1)}",
            content, flags=re.MULTILINE
        )
        if extra_flags:
            content = re.sub(r"(%.*)", rf"{extra_flags} \1", content)
        content = re.sub(r"^TryExec=.*\n?", "", content, flags=re.MULTILINE)
        content = re.sub(r"^DBusActivatable=true\n?", "", content, flags=re.MULTILINE)
        content = re.sub(r"^(.*Name.*)$", rf"\1{exported_app_label}", content, flags=re.MULTILINE)

        # For rootful containers, ensure Terminal=true under [Desktop Entry]
        if rootful:
            content = re.sub(r"^Terminal=.*$", "Terminal=true", content, flags=re.MULTILINE)
            if not re.search(r"^Terminal=", content, re.MULTILINE):
                content = re.sub(r"^(\[Desktop Entry\])", r"\1\nTerminal=true", content, flags=re.MULTILINE)

        desktop_original_stem = Path(df).stem
        content = re.sub(r"^StartupWMClass=.*\n?", "", content, flags=re.MULTILINE)
        content += f"StartupWMClass={desktop_original_stem}\n"

        # Merge Remove into existing Actions= line, or add one if absent
        if re.search(r"^Actions=", content, re.MULTILINE):
            content = re.sub(r"^(Actions=.*)$", r"\1Remove;", content, flags=re.MULTILINE)
        else:
            content += "\nActions=Remove;\n"
        content += (
            f"\n[Desktop Action Remove]\n"
            f"Name=Remove {exported_app}\n"
            f"Exec=sh -c 'rm -f {host_home}/.local/share/applications/{desktop_home_file} "
            f"{icon_host_path} && update-desktop-database {host_home}/.local/share/applications'\n"
        )

        # Copy icon and rewrite Icon=
        if icon_file:
            Path(icon_dest_dir).mkdir(parents=True, exist_ok=True)
            shutil.copy2(str(Path(icon_file).resolve()), icon_dest_file)
            content = re.sub(r"^Icon=.*$", f"Icon={icon_host_path}", content, flags=re.MULTILINE)

        dest_desktop.write_text(content)

    # Update desktop database
    subprocess.run(
        ["/usr/lib/otter/scripts/otter-host-exec", "--yes", "update-desktop-database",
         f"{host_home}/.local/share/applications"],
        capture_output=True
    )

    if exported_delete:
        print(f"Application {exported_app} successfully un-exported.\nOK!")
        print(f"{exported_app} will disappear from your applications list in a few seconds.")
    else:
        print(f"Application {exported_app} successfully exported.\nOK!")
        print(f"{exported_app} will appear in your applications list in a few seconds.")

    return 0


def list_exported_applications():
    apps_dir = f"/run/host{host_home}/.local/share/applications"
    result = subprocess.run(
        ["find", apps_dir, "-type", "f", "-print", "-o", "-type", "l", "-print"],
        capture_output=True, text=True
    )
    otter_path_pat = os.environ.get("OTTER_PATH", "otter")
    container_id = os.environ.get("CONTAINER_ID", "")

    for f in result.stdout.splitlines():
        if not f:
            continue
        try:
            content = Path(f).read_text(errors="replace")
        except OSError:
            continue
        if not re.search(rf"Exec=.*{re.escape(otter_path_pat)}.*enter.*", content):
            continue
        if not re.search(rf"/(rootful-)?{re.escape(container_id)}-[^/]+\.desktop$", f):
            continue
        m = re.search(r"^Name=(.*)$", content, re.MULTILINE)
        name = re.sub(r"\(.*\)", "", m.group(1)).strip() if m else ""
        print(f"{name:<20} | {f:<30}")


def list_exported_binaries():
    result = subprocess.run(
        ["find", dest_path_container, "-type", "f", "-print"],
        capture_output=True, text=True
    )
    container_id = os.environ.get("CONTAINER_ID", "")
    bin_list_suffix = (
        f"rootful-{container_id}"
        if Path("/usr/lib/otter/container.rootful").is_file()
        else container_id
    )

    for f in result.stdout.splitlines():
        if not f:
            continue
        try:
            content = Path(f).read_text(errors="replace")
        except OSError:
            continue
        if "# otter_binary" not in content:
            continue
        if f"# name: {bin_list_suffix}" not in content:
            continue
        # Get original binary name — match shell: grep -B1 "fi" | grep exec | cut -d' ' -f2
        name = ""
        lines = content.splitlines()
        for idx, line in enumerate(lines):
            if line.strip() == "fi" and idx > 0:
                prev = lines[idx - 1]
                if "exec" in prev:
                    parts = prev.split()
                    if len(parts) > 1:
                        name = parts[1]
                    break
        print(f"{name:<20} | {f:<30}")


# Main dispatch
if export_action == "app":
    sys.exit(export_application())
elif export_action == "bin":
    sys.exit(export_binary())
elif export_action == "list-apps":
    list_exported_applications()
elif export_action == "list-binaries":
    list_exported_binaries()
else:
    print("Invalid arguments, choose an action below.", file=sys.stderr)
    print(render_help(HELP_TEXT))
    sys.exit(2)
