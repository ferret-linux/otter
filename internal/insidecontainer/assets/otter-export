# Expected env variables:
#   HOME
#   USER
#   OTTER_PATH
#   OTTER_HOST_HOME

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from pwd import getpwnam

# Ensure env variables are correctly set
if not os.environ.get("USER"):
    os.environ["USER"] = subprocess.run(["id", "-run"], capture_output=True, text=True).stdout.strip()
if not os.environ.get("HOME"):
    os.environ["HOME"] = getpwnam(os.environ["USER"]).pw_dir
if not os.environ.get("SHELL"):
    os.environ["SHELL"] = getpwnam(os.environ["USER"]).pw_shell

# Defaults
container_name = os.environ.get("CONTAINER_ID", "")
if not container_name:
    try:
        containerenv = Path("/run/.containerenv").read_text()
        m = re.search(r'^name="?([^"\n]+)"?', containerenv, re.MULTILINE)
        if m:
            container_name = m.group(1)
    except OSError:
        pass

export_action = ""
host_home = os.environ.get("OTTER_HOST_HOME") or os.environ.get("HOME", "")
dest_path = os.environ.get("OTTER_EXPORT_PATH") or f"{host_home}/.local/bin"
rootful = ""
sudo_prefix = ""
VERSION = "0.0.9"

def render_help(text):
    color_green  = "\033[32m"  # {0} green  — command names
    color_teal   = "\033[96m"  # {1} teal   — tagline/messages
    color_cyan   = "\033[36m"  # {2} cyan   — box borders
    color_yellow = "\033[33m"  # {3} yellow — headers (▸ Section:)
    color_blue   = "\033[34m"  # {4} blue   — flags/extras
    color_dim    = "\033[37m"  # {5} dim    — descriptions/info text
    # {R} resets color
    slots = [color_green, color_teal, color_cyan, color_yellow, color_blue, color_dim]
    if os.environ.get("NO_COLOR") is not None or os.environ.get("TERM") == "dumb":
        for i in range(len(slots)):
            text = text.replace(f"{{{i}}}", "")
        return text.replace("{R}", "")
    for i, code in enumerate(slots):
        text = text.replace(f"{{{i}}}", code)
    return text.replace("{R}", "\033[0m")

