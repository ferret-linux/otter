{
  "name": "holt",
  "version": "0.1.0",
  "description": "Where your containers live",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "npm run build && electron .",
    "electron:dev": "concurrently -k -n vite,tsc,app -c cyan,blue,green \"vite --port 5173\" \"tsc -p tsconfig.node.json --watch --preserveWatchOutput\" \"wait-on tcp:127.0.0.1:5173 && electronmon . --dev\""
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electronmon": "^2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
