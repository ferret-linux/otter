#: data/dev.itznoel.Bevy.desktop.in.in:2 data/dev.itznoel.Bevy.metainfo.xml.in.in:6
msgid "@APP_NAME@"
msgstr "@APP_NAME@"

#: data/dev.itznoel.Bevy.desktop.in.in:3
msgid "A container-oriented terminal for GNOME"
msgstr "Кантэйнера-арыентаваны тэрмінал для GNOME"

#: data/dev.itznoel.Bevy.desktop.in.in:12 src/bevy-preferences-window.ui:669 src/bevy-tab.c:1647 src/bevy-util.c:318
msgid "Terminal"
msgstr "Тэрмінал"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/dev.itznoel.Bevy.desktop.in.in:14
msgid "terminal;prompt;bevy;shell;command;commandline;cmd;cli;console;container;podman;toolbox;distrobox;"
msgstr "terminal;prompt;bevy;shell;command;commandline;cmd;cli;console;container;podman;toolbox;distrobox;кансоль;камандны;загадны;радок;выканаць;тэрмінал;кантэйнер;"

#: data/dev.itznoel.Bevy.desktop.in.in:23 src/dev.itznoel.Bevy.gschema.xml.in:424 src/bevy-preferences-window.ui:742
msgid "New Window"
msgstr "Новае акно"

#: data/dev.itznoel.Bevy.desktop.in.in:27 src/dev.itznoel.Bevy.gschema.xml.in:418 src/bevy-preferences-window.ui:771
msgid "New Tab"
msgstr "Новая ўкладка"

#: data/dev.itznoel.Bevy.desktop.in.in:31 src/dev.itznoel.Bevy.gschema.xml.in:436 src/bevy-preferences-window.ui:978
msgid "Preferences"
msgstr "Налады"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:7
msgid "Container-oriented terminal"
msgstr "Кантэйнера-арыентаваны тэрмінал"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:9
msgid "Bevy is a terminal for GNOME that focuses on ease-of-use in a world of containers."
msgstr "Bevy — гэта тэрмінал для GNOME, які арыентаваны на прастае выкарыстанне ў кантэйнерах."

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:13
msgid "Features:"
msgstr "Магчымасці:"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:15
msgid "Remembers current container when opening a new tab with support for podman, toolbox, distrobox, and more"
msgstr "Запамінанне бягучага кантэйнера пры адкрыцці новай укладкі з падтрымкай podman, toolbox, distrobox і іншых"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:16
msgid "Configurable keyboard shortcuts"
msgstr "Змяняльныя налады спалучэнняў клавіш"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:17
msgid "Modern interface which integrates the palette with the window styling"
msgstr "Сучасны інтэрфейс, які аб'ядноўвае палітру і стыль акна"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:18
msgid "User-installable color palettes"
msgstr "Усталяванне палітры колераў карыстальнікам"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:19
msgid "Support for preferences profiles with container integration"
msgstr "Падтрымка профіляў налад з інтэграцыяй кантэйнераў"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:20
msgid "Integrated color palettes with light and dark support"
msgstr "Інтэграваная палітра колераў з падтрымкай светлага і цёмнага рэжыму"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:21
msgid "Tabbed interface with tab overviews"
msgstr "Укладкі і агляд укладак"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:22
msgid "Efficient foreground process tracking denoting sudo and SSH"
msgstr "Эфектыўнае адсочванне працэсаў пярэдняга плана, якія выкарыстоўваюць sudo і SSH"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:23
msgid "Support for transparent terminal backgrounds"
msgstr "Падтрымка празрыстых фонаў тэрмінала"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:24
msgid "Separate process mode for terminal-based applications"
msgstr "Асобны рэжым працэсаў для тэрмінальных праграм"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:25
msgid "Support for pinned tabs and saved sessions"
msgstr "Падтрымка замацаваных укладак і захаваных сеансаў"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:26
msgid "Terminal tabs are run within separate cgroups"
msgstr "Запуск укладак тэрмінала ў асобных кантрольных групах"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:27
msgid "Terminal inspector to help when writing terminal-based applications"
msgstr "Інспектар тэрмінала, які дапамагае пры напісанні тэрмінальных праграм"

#. developer_name tag deprecated with Appstream 1.0
#: data/dev.itznoel.Bevy.metainfo.xml.in.in:32
msgid "Christian Hergert"
msgstr "Christian Hergert"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:54
msgid "A column and row size indicator is displayed when resizing the window"
msgstr "Паказальнік памеру калонкі і радка, паказваецца пры змянення памеру акна"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:59
msgid "Containers are automatically discovered and displayed"
msgstr "Кантэйнеры аўтаматычна выяўляюцца і паказваюцца"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:64
msgid "Many behaviors of the terminal may be tweaked to user preference"
msgstr "Многія паводзіны тэрмінала можна наладзіць у адпаведнасці з патрэбамі карыстальніка"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:69
msgid "You may rename a tab by providing a prefix to the title"
msgstr "Перайменаванне ўкладак, змяняецца прэфікс у загалоўку"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:74
msgid "Palettes provide an integrated dark mode"
msgstr "Палітры колераў з убудаваным цёмным рэжымам"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:79
msgid "You can see an overview of your tabs at any time"
msgstr "Агляд усіх укладах у любы момант"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:84
msgid "Many shortcuts may be remapped to user preference"
msgstr "Большасць спалучэнняў клавіш можна перапрызначыць пад патрэбы карыстальніка"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:89
msgid "Built-in color palettes provide both dark and light mode variants"
msgstr "Убудаваныя палітры колераў з цёмным і светлым рэжымам"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:94
msgid "Profiles allow for overriding a number of features such as default container"
msgstr "Профілі дазваляюць перавызначыць некаторыя функцыі, напрыклад прадвызначаны кантэйнер"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:99
msgid "The terminal will remind you when you're root on the local system"
msgstr "Тэрмінал пакажа, калі вы працуеце ад імя root у лакальнай сістэме"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:104
msgid "The terminal will remind you when you're on a remote system"
msgstr "Тэрмінал пакажа, калі вы знаходзіцеся ў аддаленай сістэме"

#: src/main.c:142 src/main.c:149 src/main.c:161
msgid "Error"
msgstr "Памылка"

#: src/main.c:155
#, c-format
msgid ""
"Error: %s already exists.\n"
"Please remove it first.\n"
msgstr ""
"Памылка: %s ужо існуе.\n"
"Спачатку выдаліце яго.\n"

#: src/dev.itznoel.Bevy.gschema.xml.in:101
msgid "Default Profile UUID"
msgstr "UUID прадвызначанага профілю"

#: src/dev.itznoel.Bevy.gschema.xml.in:102
msgid "The UUID of the default profile"
msgstr "UUID прадвызначанага профілю"

#: src/dev.itznoel.Bevy.gschema.xml.in:107
msgid "UUIDs of all Profiles"
msgstr "UUID усіх профіляў"

#: src/dev.itznoel.Bevy.gschema.xml.in:108
msgid "A list of UUID for every profile"
msgstr "Спіс усіх UUID для кожнага з профіляў"

#: src/dev.itznoel.Bevy.gschema.xml.in:113 src/bevy-preferences-window.ui:322
msgid "New Tab Position"
msgstr "Пазіцыя новай укладкі"

#: src/dev.itznoel.Bevy.gschema.xml.in:114
msgid "Where to place new tabs"
msgstr "Дзе размяшчаць новую ўкладку, за бягучай (next) або ў канцы (last)"

#: src/dev.itznoel.Bevy.gschema.xml.in:119 src/bevy-preferences-window.ui:414
msgid "Audible Bell"
msgstr "Гукавы сігнал"

#: src/dev.itznoel.Bevy.gschema.xml.in:120
msgid "If an audible bell should be used"
msgstr "Ці выкарыстоўваць гукавы сігнал"

#: src/dev.itznoel.Bevy.gschema.xml.in:125
msgid "Visible Bell"
msgstr "Візуальны сігнал"

#: src/dev.itznoel.Bevy.gschema.xml.in:126
msgid "If a visual bell should be used"
msgstr "Ці выкарыстоўваць візуальны сігнал"

#: src/dev.itznoel.Bevy.gschema.xml.in:131
msgid "Visual Process Leader"
msgstr "Візуальнае пазначэнне лідара працэсаў"

#: src/dev.itznoel.Bevy.gschema.xml.in:132
msgid "Display a visual window highlight when process leader is SSH, sudo, or other specialized tooling"
msgstr "Падсвечваць акно, калі лідарам працэсаў выступае SSH, sudo або іншыя спецыялізаваныя інструменты"

#: src/dev.itznoel.Bevy.gschema.xml.in:137
msgid "Use System Font"
msgstr "Выкарыстоўваць сістэмны шрыфт"

#: src/dev.itznoel.Bevy.gschema.xml.in:138
msgid "If the default system monospace font should be used"
msgstr "Ці выкарыстоўваць прадвызначаны сістэмны монашырынны шрыфт"

#: src/dev.itznoel.Bevy.gschema.xml.in:143
msgid "Font Name"
msgstr "Назва шрыфту"

#: src/dev.itznoel.Bevy.gschema.xml.in:144
msgid "The font description to use if use-system-font is set to False"
msgstr "Апісанне шрыфту, які выкарыстоўваецца, калі значэнне ключа use-system-font «False»"

#: src/dev.itznoel.Bevy.gschema.xml.in:149 src/bevy-preferences-window.ui:249
msgid "Cursor Shape"
msgstr "Форма курсора"

#: src/dev.itznoel.Bevy.gschema.xml.in:150
msgid "The default shape of the cursor"
msgstr "Прадвызначаная форма курсора"

#: src/dev.itznoel.Bevy.gschema.xml.in:155
msgid "Cursor Blink Mode"
msgstr "Рэжым мільгання курсора"

#: src/dev.itznoel.Bevy.gschema.xml.in:156
msgid "The default blink mode cursor"
msgstr "Прадвызначаны рэжым мільгання курсора"

#: src/dev.itznoel.Bevy.gschema.xml.in:161
msgid "List of punctuation characters that are treated as word characters"
msgstr "Спіс знакаў прыпынку, якія апрацоўваюцца як сімвалы слоў"

#: src/dev.itznoel.Bevy.gschema.xml.in:162
msgid "By default, when doing word-wise selection, most punctuation breaks up word boundaries. This list of exceptions will instead be treated as part of the word."
msgstr "Прадвызначана, пры вылучэнні па словах, большасць знакаў прыпынку парушаюць межы слоў. Выключэнні з гэтага спіса будуць апрацоўвацца як частка слова."

#: src/dev.itznoel.Bevy.gschema.xml.in:167
msgid "Scrollbar Policy"
msgstr "Правілы паказу палос прагорткі"

#: src/dev.itznoel.Bevy.gschema.xml.in:168
msgid "If scrollbars should be displayed"
msgstr "Ці паказваць палосы прагорткі"

#: src/dev.itznoel.Bevy.gschema.xml.in:177
msgid "Text Blink Mode"
msgstr "Рэжым мільгання тэксту"

#: src/dev.itznoel.Bevy.gschema.xml.in:178
msgid "When text blinking is allowed"
msgstr "Калі дазволена мільганне тэксту"

#: src/dev.itznoel.Bevy.gschema.xml.in:183
msgid "Interface Style"
msgstr "Стыль інтэрфейсу"

#: src/dev.itznoel.Bevy.gschema.xml.in:184
msgid "If light or dark interface style should be used"
msgstr "Які стыль інтэрфейсу выкарыстоўваць, цёмны (dark) ці светлы (light)"

#: src/dev.itznoel.Bevy.gschema.xml.in:189 src/bevy-preferences-window.ui:351
msgid "Restore Session"
msgstr "Аднаўляць сеанс"

#: src/dev.itznoel.Bevy.gschema.xml.in:190
msgid "Restore tabs from previous session when starting Bevy"
msgstr "Аднаўляць укладкі з папярэдняга сеанса пры запуску Bevy"

#: src/dev.itznoel.Bevy.gschema.xml.in:195 src/bevy-preferences-window.ui:357
msgid "Restore Window Size"
msgstr "Аднаўляць памер акна"

#: src/dev.itznoel.Bevy.gschema.xml.in:196
msgid "Restore the previous window size when creating new windows"
msgstr "Аднаўляць папярэдні памер акна пры стварэнні новых"

#: src/dev.itznoel.Bevy.gschema.xml.in:206
msgid "Default Column Size"
msgstr "Прадвызначаная шырыня слупка"

#: src/dev.itznoel.Bevy.gschema.xml.in:207 src/dev.itznoel.Bevy.gschema.xml.in:214
msgid "Default window size when restore-window-size is not true."
msgstr "Прадвызначаны памер акна, калі значэнне ключа restore-window-size не «true»."

#: src/dev.itznoel.Bevy.gschema.xml.in:213
msgid "Default Row Size"
msgstr "Прадвызначаны памер радка"

#: src/dev.itznoel.Bevy.gschema.xml.in:219
msgid "Toast on Copy Clipboard"
msgstr "Паведамленне пра капіяванне ў буфер абмену"

#: src/dev.itznoel.Bevy.gschema.xml.in:220
msgid "Show the user when text has copied to the clipboard."
msgstr "Паказваць карыстальніку паведамленне, што тэкст скапіяваны ў буфер абмену."

#: src/dev.itznoel.Bevy.gschema.xml.in:225
msgid "Enable Accessibility"
msgstr "Уключыць спецыяльныя магчымасці"

#: src/dev.itznoel.Bevy.gschema.xml.in:226
msgid "Currently experimental feature to send accessibility information to screen readers."
msgstr "У гэты час гэта эксперыментальная функцыя для адпраўкі інфармацыі сродкам чытання з экрана."

#: src/dev.itznoel.Bevy.gschema.xml.in:231
msgid "Enable zoom on scroll holding the control key"
msgstr "Уключыць маштабаванне прагортваннем пры націснутай клавішы Ctrl"

#: src/dev.itznoel.Bevy.gschema.xml.in:232
msgid "Enable to adjust the zoom level on scroll scroll while holding the control key."
msgstr "Уключае магчымасць змяняць узровень маштабавання прагортваннем, калі націснута клавіша Ctrl."

#: src/dev.itznoel.Bevy.gschema.xml.in:237
msgid "Disable Padding around Terminal Emulator"
msgstr "Адключыць водступы вакол эмулятара тэрмінала"

#: src/dev.itznoel.Bevy.gschema.xml.in:238
msgid "Do not pad around the terminal emulator widget. Setting to true may have significant performance impacts."
msgstr "Не рабіць водступы вакол віджэта эмулятара тэрмінала. Выбар значэння «true» можа істотна паўплываць на прадукцыйнасць."

#: src/dev.itznoel.Bevy.gschema.xml.in:243
msgid "Prompt when active tab is closed"
msgstr "Запытваць пацвярджэнне, калі закрываецца актыўная ўкладка"

#: src/dev.itznoel.Bevy.gschema.xml.in:244
msgid "If a tab (or window) is closed with active foreground processes, prompt the user for confirmation."
msgstr "Калі закрываецца ўкладка (або акно) з актыўнымі працэсам пярэдняга плана, запытваць у карыстальніка пацвярджэнне."

#. Translators: OSC stands for "Operating System Command" and is referencing in-band escape sequences from the child process to set the title
#: src/dev.itznoel.Bevy.gschema.xml.in:250
msgid "Ignore OSC Title"
msgstr "Ігнараваць загаловак OSC"

#: src/dev.itznoel.Bevy.gschema.xml.in:251
msgid "If OSC title should be ignored in tab titles."
msgstr "Ці ігнараваць загалоўкі OSC у загалоўках укладак."

#: src/dev.itznoel.Bevy.gschema.xml.in:256
msgid "Inhibit Logout"
msgstr "Блакіраваць выхад з сістэмы"

#: src/dev.itznoel.Bevy.gschema.xml.in:257
msgid "Inhibit desktop logout when a foreground process is running in a tab."
msgstr "Блакіраваць выхад з сістэмы, калі ва ўкладцы запушчаны працэс пярэдняга плана."

#: src/dev.itznoel.Bevy.gschema.xml.in:266
msgid "Label"
msgstr "Назва"

#: src/dev.itznoel.Bevy.gschema.xml.in:267
msgid "The label for the profile"
msgstr "Назва профілю"

#: src/dev.itznoel.Bevy.gschema.xml.in:272
msgid "Login Shell"
msgstr "Камандная абалонка"

#: src/dev.itznoel.Bevy.gschema.xml.in:273
msgid "Use a login shell"
msgstr "Выкарыстоўваць камандную абалонку"

#: src/dev.itznoel.Bevy.gschema.xml.in:278 src/bevy-preferences-window.ui:482 src/bevy-profile-editor.ui:333
msgid "Limit Scrollback"
msgstr "Абмежаванне для прагорткі назад"

#: src/dev.itznoel.Bevy.gschema.xml.in:279
msgid "Limit the number of lines to keep for scrollback"
msgstr "Прагортка назад, абмежаванне колькасці радкоў, якія захоўваюцца ў памяці"

#: src/dev.itznoel.Bevy.gschema.xml.in:285 src/bevy-preferences-window.ui:491 src/bevy-profile-editor.ui:342
msgid "Scrollback Lines"
msgstr "Колькасць радкоў для прагорткі назад"

#: src/dev.itznoel.Bevy.gschema.xml.in:286
msgid "The number of lines to keep in the scrollback, zero for no scrollback"
msgstr "Прагортка назад, колькасць радкоў, якія захоўваюцца ў памяці. Пры нулявым значэнні не захоўваюцца"

#: src/dev.itznoel.Bevy.gschema.xml.in:291 src/bevy-preferences-window.ui:472 src/bevy-profile-editor.ui:323
msgid "Scroll on Output"
msgstr "Прагортваць пры новым вывадзе"

#: src/dev.itznoel.Bevy.gschema.xml.in:292
msgid "Scroll to the bottom upon new output"
msgstr "Прагортваць уніз пры з'яўленні новага вываду ў тэрмінале"

#: src/dev.itznoel.Bevy.gschema.xml.in:297 src/bevy-preferences-window.ui:466 src/bevy-profile-editor.ui:317
msgid "Scroll on Keystroke"
msgstr "Прагортваць пры націсканні клавішы"

#: src/dev.itznoel.Bevy.gschema.xml.in:298
msgid "Scroll to the bottom upon user keystroke"
msgstr "Прагортваць уніз пры націсканні клавішы"

#: src/dev.itznoel.Bevy.gschema.xml.in:303 src/bevy-profile-editor.ui:187
msgid "Use Custom Command"
msgstr "Выкарыстоўваць уласную каманду"

#: src/dev.itznoel.Bevy.gschema.xml.in:304
msgid "If a custom command should be used"
msgstr "Ці выкарыстоўваць уласную каманду"

#: src/dev.itznoel.Bevy.gschema.xml.in:309
msgid "Use Proxy"
msgstr "Выкарыстоўваць проксі"

#: src/dev.itznoel.Bevy.gschema.xml.in:310
msgid "Apply proxy settings from the host in the container"
msgstr "Ужыць налады проксі з асноўнай сістэмы ў кантэйнеры"

#: src/dev.itznoel.Bevy.gschema.xml.in:315 src/bevy-profile-editor.ui:192
msgid "Custom Command"
msgstr "Уласная каманда"

#: src/dev.itznoel.Bevy.gschema.xml.in:316
msgid "A custom command for the shell"
