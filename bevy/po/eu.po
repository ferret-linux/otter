msgstr "Profil lehenetsiaren UUIDa"

#: src/dev.itznoel.Bevy.gschema.xml.in:107
msgid "UUIDs of all Profiles"
msgstr "Profil guztien UUIDak"

#: src/dev.itznoel.Bevy.gschema.xml.in:108
msgid "A list of UUID for every profile"
msgstr "Profil bakoitzaren UUIDaren zerrenda"

#: src/dev.itznoel.Bevy.gschema.xml.in:113 src/bevy-preferences-window.ui:322
msgid "New Tab Position"
msgstr "Fitxa berriaren posizioa"

#: src/dev.itznoel.Bevy.gschema.xml.in:114
msgid "Where to place new tabs"
msgstr "Non kokatu fitxa berriak"

#: src/dev.itznoel.Bevy.gschema.xml.in:119 src/bevy-preferences-window.ui:414
msgid "Audible Bell"
msgstr "Kanpai entzungarria"

#: src/dev.itznoel.Bevy.gschema.xml.in:120
msgid "If an audible bell should be used"
msgstr "Entzuten den kanpaia erabiliko den"

#: src/dev.itznoel.Bevy.gschema.xml.in:125
msgid "Visible Bell"
msgstr "Kanpai ikusgarria"

#: src/dev.itznoel.Bevy.gschema.xml.in:126
msgid "If a visual bell should be used"
msgstr "Ikusten den kanpaia erabiliko den"

#: src/dev.itznoel.Bevy.gschema.xml.in:131
msgid "Visual Process Leader"
msgstr "Ikusizko prozesu-liderra"

#: src/dev.itznoel.Bevy.gschema.xml.in:132
msgid ""
"Display a visual window highlight when process leader is SSH, sudo, or other "
"specialized tooling"
msgstr "Bistaratu leihoaren ikusizko nabarmentzea prozesu-liderra SSH, sudo edo beste tresna espezializatu bat denean"

#: src/dev.itznoel.Bevy.gschema.xml.in:137
msgid "Use System Font"
msgstr "Erabili sistemaren letra-tipoa"

#: src/dev.itznoel.Bevy.gschema.xml.in:138
msgid "If the default system monospace font should be used"
msgstr "Sistemaren tarte bakarreko letra-tipo lehenetsia erabiliko den ala ez"

#: src/dev.itznoel.Bevy.gschema.xml.in:143
msgid "Font Name"
msgstr "Letra-izena"

#: src/dev.itznoel.Bevy.gschema.xml.in:144
msgid "The font description to use if use-system-font is set to False"
msgstr "use-system-font ezarpenean faltsua ezartzen bada erabiliko den letra-deskribapena"

#: src/dev.itznoel.Bevy.gschema.xml.in:149 src/bevy-preferences-window.ui:249
msgid "Cursor Shape"
msgstr "Kurtsorearen forma"

#: src/dev.itznoel.Bevy.gschema.xml.in:150
msgid "The default shape of the cursor"
msgstr "Kurtsorearen forma lehenetsia"

#: src/dev.itznoel.Bevy.gschema.xml.in:155
msgid "Cursor Blink Mode"
msgstr "Kurtsorearen keinuaren modua"

#: src/dev.itznoel.Bevy.gschema.xml.in:156
msgid "The default blink mode cursor"
msgstr "Kurtsorea keinuaren modu lehenetsia"

#: src/dev.itznoel.Bevy.gschema.xml.in:161
msgid "List of punctuation characters that are treated as word characters"
msgstr "Hitz-karakteretzat hartzen diren puntuazio-karaktereen zerrenda"

#: src/dev.itznoel.Bevy.gschema.xml.in:162
msgid ""
"By default, when doing word-wise selection, most punctuation breaks up word "
"boundaries. This list of exceptions will instead be treated as part of the "
"word."
msgstr "Modu lehenetsian, hitzak hautatzean, puntuazioak hitzak hausten ditu. Salbuespenen zerrenda honetakoak, berriz, hitzaren partetzat hartuko dira."

#: src/dev.itznoel.Bevy.gschema.xml.in:167
msgid "Scrollbar Policy"
msgstr "Korritze-barraren politika"

#: src/dev.itznoel.Bevy.gschema.xml.in:168
msgid "If scrollbars should be displayed"
msgstr "Korritze-barrak bistaratu behar diren ala ez"

#: src/dev.itznoel.Bevy.gschema.xml.in:177
msgid "Text Blink Mode"
msgstr "Testuaren keinuaren modua"

#: src/dev.itznoel.Bevy.gschema.xml.in:178
msgid "When text blinking is allowed"
msgstr "Testuaren keinuak onartzen diren ala ez"

#: src/dev.itznoel.Bevy.gschema.xml.in:183
msgid "Interface Style"
msgstr "Interfazearen estiloa"

#: src/dev.itznoel.Bevy.gschema.xml.in:184
msgid "If light or dark interface style should be used"
msgstr "Interfaze argia ala iluna erabiliko den"

#: src/dev.itznoel.Bevy.gschema.xml.in:189 src/bevy-preferences-window.ui:351
msgid "Restore Session"
msgstr "Leheneratu saioa"

#: src/dev.itznoel.Bevy.gschema.xml.in:190
msgid "Restore tabs from previous session when starting Bevy"
msgstr "Leheneratu aurreko saioaren fitxak Bevy abiaraztean"

#: src/dev.itznoel.Bevy.gschema.xml.in:195 src/bevy-preferences-window.ui:357
msgid "Restore Window Size"
msgstr "Leheneratu leiho-tamaina"

#: src/dev.itznoel.Bevy.gschema.xml.in:196
msgid "Restore the previous window size when creating new windows"
msgstr "Leheneratu aurreko leiho-tamaina leiho berriak sortzean"

#: src/dev.itznoel.Bevy.gschema.xml.in:206
msgid "Default Column Size"
msgstr "Zutabe-tamaina lehenetsia"

#: src/dev.itznoel.Bevy.gschema.xml.in:207
#: src/dev.itznoel.Bevy.gschema.xml.in:214
msgid "Default window size when restore-window-size is not true."
msgstr "Leihoaren tamaina lehenetsia restore-window-size egia ez denean."

#: src/dev.itznoel.Bevy.gschema.xml.in:213
msgid "Default Row Size"
msgstr "Errenkada-tamaina lehenetsia"

#: src/dev.itznoel.Bevy.gschema.xml.in:219
msgid "Toast on Copy Clipboard"
msgstr "Jakinarazpena arbelean kopiatzean"

#: src/dev.itznoel.Bevy.gschema.xml.in:220
msgid "Show the user when text has copied to the clipboard."
msgstr "Erakutsi erabiltzaileari testua arbelean kopiatu dela."

#: src/dev.itznoel.Bevy.gschema.xml.in:225
msgid "Enable Accessibility"
msgstr "Gaitu irisgarritasuna"

#: src/dev.itznoel.Bevy.gschema.xml.in:226
msgid ""
"Currently experimental feature to send accessibility information to screen "
"readers."
msgstr "Eginbide esperimentala, irisgarritasun-informazioa pantaila-irakurleei bidaltzeko."

#: src/dev.itznoel.Bevy.gschema.xml.in:231
msgid "Enable zoom on scroll holding the control key"
msgstr "Gaitu zoom egitea korritzean kontrol teklari eutsita"

#: src/dev.itznoel.Bevy.gschema.xml.in:232
msgid ""
"Enable to adjust the zoom level on scroll scroll while holding the control "
"key."
msgstr "Korritzean kontrol teklari eusten zaionean zoom-maila doitzea ahalbidetzen du."

#: src/dev.itznoel.Bevy.gschema.xml.in:237
msgid "Disable Padding around Terminal Emulator"
msgstr "Desgaitu terminal-emulatzailearen inguruko betegarria"

#: src/dev.itznoel.Bevy.gschema.xml.in:238
msgid ""
"Do not pad around the terminal emulator widget. Setting to true may have "
"significant performance impacts."
msgstr "Ez erantsi betegarririk terminal-emulatzailearen trepetaren inguruan. Egia ezartzen bada, errendimenduan aldaketa esanguratsuak egon daitezke."

#: src/dev.itznoel.Bevy.gschema.xml.in:243
msgid "Prompt when active tab is closed"
msgstr "Galdetu fitxa aktiboa ixten denean"

#: src/dev.itznoel.Bevy.gschema.xml.in:244
msgid ""
"If a tab (or window) is closed with active foreground processes, prompt the "
"user for confirmation."
msgstr "Aurreko planoko prozesu aktiboak dituen fitxa (edo leiho) bat ixten denean, galdetu erabiltzaileari berresteko."

#. Translators: OSC stands for "Operating System Command" and is referencing in-band escape sequences from the child process to set the title
#: src/dev.itznoel.Bevy.gschema.xml.in:250
msgid "Ignore OSC Title"
msgstr "Ez ikusiarena egin OSC izenburuari"

#: src/dev.itznoel.Bevy.gschema.xml.in:251
msgid "If OSC title should be ignored in tab titles."
msgstr "OSC izenburuari ez ikusiarena egingo zaion ala ez fitxen izenburuetan."

#: src/dev.itznoel.Bevy.gschema.xml.in:256
msgid "Inhibit Logout"
msgstr "Galarazi saio-amaiera"

#: src/dev.itznoel.Bevy.gschema.xml.in:257
msgid "Inhibit desktop logout when a foreground process is running in a tab."
msgstr "Galarazi mahaigainaren saio-amaiera aurreko planoko prozesu bat fitxa batean exekutatzen ari denean."

#: src/dev.itznoel.Bevy.gschema.xml.in:266
msgid "Label"
msgstr "Etiketa"

#: src/dev.itznoel.Bevy.gschema.xml.in:267
msgid "The label for the profile"
msgstr "Profilaren etiketa"

#: src/dev.itznoel.Bevy.gschema.xml.in:272
msgid "Login Shell"
msgstr "Saio-hasierako shell-a"

#: src/dev.itznoel.Bevy.gschema.xml.in:273
msgid "Use a login shell"
msgstr "Erabili saio-hasierako shell-a"

#: src/dev.itznoel.Bevy.gschema.xml.in:278 src/bevy-preferences-window.ui:482
#: src/bevy-profile-editor.ui:333
msgid "Limit Scrollback"
msgstr "Mugatu atzeranzko korritzea"

#: src/dev.itznoel.Bevy.gschema.xml.in:279
msgid "Limit the number of lines to keep for scrollback"
msgstr "Mugatu atzeranzko korritzearen lerro kopurua"

#: src/dev.itznoel.Bevy.gschema.xml.in:285 src/bevy-preferences-window.ui:491
#: src/bevy-profile-editor.ui:342
msgid "Scrollback Lines"
msgstr "Atzeranzko korritzearen lerroak"

#: src/dev.itznoel.Bevy.gschema.xml.in:286
msgid "The number of lines to keep in the scrollback, zero for no scrollback"
msgstr "Atzeranzko korritzearen lerro koopurua, zero korritzerik ez gertatzeko"

#: src/dev.itznoel.Bevy.gschema.xml.in:291 src/bevy-preferences-window.ui:472
#: src/bevy-profile-editor.ui:323
msgid "Scroll on Output"
msgstr "Korritu irteeran"

#: src/dev.itznoel.Bevy.gschema.xml.in:292
msgid "Scroll to the bottom upon new output"
msgstr "Beheraino korritu irteera berri bat dagoenean"

#: src/dev.itznoel.Bevy.gschema.xml.in:297 src/bevy-preferences-window.ui:466
#: src/bevy-profile-editor.ui:317
msgid "Scroll on Keystroke"
msgstr "Korritu tekla-sakatzean"

#: src/dev.itznoel.Bevy.gschema.xml.in:298
msgid "Scroll to the bottom upon user keystroke"
msgstr "Beheraino korritu erabiltzaileak tekla bat sakatzean"

#: src/dev.itznoel.Bevy.gschema.xml.in:303 src/bevy-profile-editor.ui:187
msgid "Use Custom Command"
msgstr "Erabili komando pertsonalizatua"

#: src/dev.itznoel.Bevy.gschema.xml.in:304
msgid "If a custom command should be used"
msgstr "Komando pertsonalizatua erabiliko den"

#: src/dev.itznoel.Bevy.gschema.xml.in:309
msgid "Use Proxy"
msgstr "Erabili proxya"

#: src/dev.itznoel.Bevy.gschema.xml.in:310
msgid "Apply proxy settings from the host in the container"
msgstr "Aplikatu ostalariaren proxy-ezarpenak edukiontzian"

#: src/dev.itznoel.Bevy.gschema.xml.in:315 src/bevy-profile-editor.ui:192
msgid "Custom Command"
msgstr "Komando pertsonalizatua"

#: src/dev.itznoel.Bevy.gschema.xml.in:316
msgid "A custom command for the shell"
msgstr "Komando pertsonalizatua shell-erako"

#: src/dev.itznoel.Bevy.gschema.xml.in:321 src/bevy-profile-editor.ui:211
msgid "Default Container"
msgstr "Edukiontzi lehenetsia"

#: src/dev.itznoel.Bevy.gschema.xml.in:322
msgid "The default container to run the command in"
msgstr "Komandoa exekutatzeko erabiliko den edukiontzi lehenetsia"

#: src/dev.itznoel.Bevy.gschema.xml.in:327 src/bevy-profile-editor.ui:220
msgid "Preserve Container"
msgstr "Mantendu edukiontzia"

#: src/dev.itznoel.Bevy.gschema.xml.in:328
msgid "Preserve the active container when creating new tabs and windows"
msgstr "Mantendu edukiontzi aktiboa fitxa eta leiho berriak sortzean"

#: src/dev.itznoel.Bevy.gschema.xml.in:333 src/bevy-preferences-window.ui:551
#: src/bevy-profile-editor.ui:281
msgid "Exit Action"
msgstr "Irteteko ekintza"

#: src/dev.itznoel.Bevy.gschema.xml.in:334
msgid "The action to take when the shell exits"
msgstr "Gauzatuko den ekintza shell-etik irtetean"

#: src/dev.itznoel.Bevy.gschema.xml.in:339
msgid "Preserve Directory"
msgstr "Mantendu direktorioa"

#: src/dev.itznoel.Bevy.gschema.xml.in:340
msgid "If the directory should be preserved for new terminals"
msgstr "Direktorioa mantendu behar den ala ez terminal berrietan"

#: src/dev.itznoel.Bevy.gschema.xml.in:345 src/bevy-inspector.ui:102
#: src/bevy-preferences-window.ui:40 src/bevy-profile-editor.ui:65
msgid "Palette"
msgstr "Paleta"

#: src/dev.itznoel.Bevy.gschema.xml.in:346
msgid "The color palette to use for the profile, by name"
msgstr "Profilean erabiltzeko kolore-paleta, izenaren arabera"

#: src/dev.itznoel.Bevy.gschema.xml.in:352
msgid "Opacity"
msgstr "Opakutasuna"

#: src/dev.itznoel.Bevy.gschema.xml.in:353
msgid "The opacity of the palette background"
msgstr "Paletaren atzeko planoaren opakutasuna"

#: src/dev.itznoel.Bevy.gschema.xml.in:358
msgid "Bold is Bright"
msgstr "Lodia distiratsua da"

#: src/dev.itznoel.Bevy.gschema.xml.in:359
msgid ""
"Setting bold on one of the lower 8 colors in the palette will use bright "
"variant (upper 8 colors)"
msgstr "Paletaren beheko 8 koloretako baten bertio lodiak aldaera distiratsua (goiko 8 koloreak) erabiliko du"

#: src/dev.itznoel.Bevy.gschema.xml.in:365 src/bevy-preferences-window.ui:175
#: src/bevy-profile-editor.ui:143
msgid "Line Spacing"
msgstr "Lerroen arteko tartea"

#: src/dev.itznoel.Bevy.gschema.xml.in:366
msgid "The terminal’s cell height scale"
msgstr "Terminalaren gelaxka-altueraren eskala"

#: src/dev.itznoel.Bevy.gschema.xml.in:372 src/bevy-preferences-window.ui:189
#: src/bevy-profile-editor.ui:157
msgid "Column Spacing"
msgstr "Zutabeen arteko tartea"

#: src/dev.itznoel.Bevy.gschema.xml.in:373
msgid "The terminal’s cell width scale"
msgstr "Terminalaren gelaxka-zabaleraren eskala"

#: src/dev.itznoel.Bevy.gschema.xml.in:378
