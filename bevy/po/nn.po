msgid "New Window"
msgstr "Nytt vindauge"

#: data/dev.itznoel.Bevy.desktop.in.in:27
#: src/dev.itznoel.Bevy.gschema.xml.in:418 src/bevy-preferences-window.ui:771
msgid "New Tab"
msgstr "Ny fane"

#: data/dev.itznoel.Bevy.desktop.in.in:31
#: src/dev.itznoel.Bevy.gschema.xml.in:436 src/bevy-preferences-window.ui:978
msgid "Preferences"
msgstr "Innstillingar"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:7
msgid "Container-oriented terminal"
msgstr "Container-orientert terminal"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:9
msgid ""
"Bevy is a terminal for GNOME that focuses on ease-of-use in a world of "
"containers."
msgstr ""
"Bevy er ein terminal for GNOME som legg vekt på enkel bruk i ei verd av "
"containerar."

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:13
msgid "Features:"
msgstr "Funksjonar:"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:15
msgid ""
"Remembers current container when opening a new tab with support for podman, "
"toolbox, distrobox, and more"
msgstr ""
"Hugsar gjeldande container når du opnar ei ny fane, med støtte for podman, "
"toolbox, distrobox og meir"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:16
msgid "Configurable keyboard shortcuts"
msgstr "Valfrie tastatursnarvegar"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:17
msgid "Modern interface which integrates the palette with the window styling"
msgstr "Moderne grensesnitt som integrerer paletten med vindaugestilen"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:18
msgid "User-installable color palettes"
msgstr "Brukarinstallerbare fargepalettar"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:19
msgid "Support for preferences profiles with container integration"
msgstr "Støtte for innstillingsprofilar med container-integrasjon"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:20
msgid "Integrated color palettes with light and dark support"
msgstr "Integrerte fargepalettar med støtte for lyst og mørkt tema"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:21
msgid "Tabbed interface with tab overviews"
msgstr "Fanebasert grensesnitt med oversikt over faner"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:22
msgid "Efficient foreground process tracking denoting sudo and SSH"
msgstr "Effektiv sporing av forgrunnsprosessar som viser sudo og SSH"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:23
msgid "Support for transparent terminal backgrounds"
msgstr "Støtte for gjennomsiktige terminalbakgrunnar"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:24
msgid "Separate process mode for terminal-based applications"
msgstr "Eiga prosessmodus for terminalbaserte program"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:25
msgid "Support for pinned tabs and saved sessions"
msgstr "Støtte for festa faner og lagra økter"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:26
msgid "Terminal tabs are run within separate cgroups"
msgstr "Terminalfaner køyrer i eigne cgroups"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:27
msgid "Terminal inspector to help when writing terminal-based applications"
msgstr "Terminalinspektør som hjelper når du skriv terminalbaserte program"

#. developer_name tag deprecated with Appstream 1.0
#: data/dev.itznoel.Bevy.metainfo.xml.in.in:32
msgid "Christian Hergert"
msgstr "Christian Hergert"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:54
msgid "A column and row size indicator is displayed when resizing the window"
msgstr ""
"Ein kolonne- og radstorleiksindikator vert vist når vindauget vert endra"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:59
msgid "Containers are automatically discovered and displayed"
msgstr "Containerar vert automatisk oppdaga og viste"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:64
msgid "Many behaviors of the terminal may be tweaked to user preference"
msgstr "Mange åtferder i terminalen kan justerast etter brukarpreferansar"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:69
msgid "You may rename a tab by providing a prefix to the title"
msgstr "Du kan gje ei fane nytt namn ved å leggja til eit prefiks til tittelen"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:74
msgid "Palettes provide an integrated dark mode"
msgstr "Palettar gjev ein integrert mørk modus"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:79
msgid "You can see an overview of your tabs at any time"
msgstr "Du kan sjå ei oversikt over fanene dine når som helst"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:84
msgid "Many shortcuts may be remapped to user preference"
msgstr "Mange snarvegar kan omdefinerast etter brukarpreferansar"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:89
msgid "Built-in color palettes provide both dark and light mode variants"
msgstr "Innebygde fargepalettar gjev både mørke og lyse variantar"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:94
msgid ""
"Profiles allow for overriding a number of features such as default container"
msgstr ""
"Profilar gjev høve til å overstyra fleire funksjonar, som standardcontainer"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:99
msgid "The terminal will remind you when you're root on the local system"
msgstr "Terminalen minner deg på når du er root på det lokale systemet"

#: data/dev.itznoel.Bevy.metainfo.xml.in.in:104
msgid "The terminal will remind you when you're on a remote system"
msgstr "Terminalen minner deg på når du er på eit eksternt system"

#: src/main.c:142 src/main.c:149 src/main.c:161
msgid "Error"
msgstr "Feil"

#: src/main.c:155
#, c-format
msgid ""
"Error: %s already exists.\n"
"Please remove it first.\n"
msgstr ""
"Feil: %s finst alt.\n"
"Fjern det først.\n"

#: src/dev.itznoel.Bevy.gschema.xml.in:101
msgid "Default Profile UUID"
msgstr "Standardprofil-UUID"

#: src/dev.itznoel.Bevy.gschema.xml.in:102
msgid "The UUID of the default profile"
msgstr "UUID-en til standardprofilen"

#: src/dev.itznoel.Bevy.gschema.xml.in:107
msgid "UUIDs of all Profiles"
msgstr "UUID-ar for alle profilar"

#: src/dev.itznoel.Bevy.gschema.xml.in:108
msgid "A list of UUID for every profile"
msgstr "Ei liste med UUID for kvar profil"

#: src/dev.itznoel.Bevy.gschema.xml.in:113 src/bevy-preferences-window.ui:322
msgid "New Tab Position"
msgstr "Plassering av ny fane"

#: src/dev.itznoel.Bevy.gschema.xml.in:114
msgid "Where to place new tabs"
msgstr "Kvar nye faner skal plasserast"

#: src/dev.itznoel.Bevy.gschema.xml.in:119 src/bevy-preferences-window.ui:414
msgid "Audible Bell"
msgstr "Høyrbar bjelle"

#: src/dev.itznoel.Bevy.gschema.xml.in:120
msgid "If an audible bell should be used"
msgstr "Om ei høyrbar bjelle skal brukast"

#: src/dev.itznoel.Bevy.gschema.xml.in:125
msgid "Visible Bell"
msgstr "Synleg bjelle"

#: src/dev.itznoel.Bevy.gschema.xml.in:126
msgid "If a visual bell should be used"
msgstr "Om ei visuell bjelle skal brukast"

#: src/dev.itznoel.Bevy.gschema.xml.in:131
msgid "Visual Process Leader"
msgstr "Visuell prosessleiar"

#: src/dev.itznoel.Bevy.gschema.xml.in:132
msgid ""
"Display a visual window highlight when process leader is SSH, sudo, or other "
"specialized tooling"
msgstr ""
"Vis eit visuelt vindaugsframheving når prosessleiaren er SSH, sudo eller "
"anna spesialisert verktøy"

#: src/dev.itznoel.Bevy.gschema.xml.in:137
msgid "Use System Font"
msgstr "Bruk systemskrifttype"

#: src/dev.itznoel.Bevy.gschema.xml.in:138
msgid "If the default system monospace font should be used"
msgstr "Om standardskrifttypen med fast breidd frå systemet skal brukast"

#: src/dev.itznoel.Bevy.gschema.xml.in:143
msgid "Font Name"
msgstr "Skriftnamn"

#: src/dev.itznoel.Bevy.gschema.xml.in:144
msgid "The font description to use if use-system-font is set to False"
msgstr ""
"Skriftskildringa som skal brukast dersom bruk-systemskrift er sett til Usann"

#: src/dev.itznoel.Bevy.gschema.xml.in:149 src/bevy-preferences-window.ui:249
msgid "Cursor Shape"
msgstr "Markørform"

#: src/dev.itznoel.Bevy.gschema.xml.in:150
msgid "The default shape of the cursor"
msgstr "Standardforma på markøren"

#: src/dev.itznoel.Bevy.gschema.xml.in:155
msgid "Cursor Blink Mode"
msgstr "Blinkemodus for markør"

#: src/dev.itznoel.Bevy.gschema.xml.in:156
msgid "The default blink mode cursor"
msgstr "Standard blinkemodus for markøren"

#: src/dev.itznoel.Bevy.gschema.xml.in:161
msgid "List of punctuation characters that are treated as word characters"
msgstr "Liste over teiknsetjingsteikn som skal reknast som ordteikn"

#: src/dev.itznoel.Bevy.gschema.xml.in:162
msgid ""
"By default, when doing word-wise selection, most punctuation breaks up word "
"boundaries. This list of exceptions will instead be treated as part of the "
"word."
msgstr ""
"Som standard, når ein gjer ordvis markering, bryt dei fleste "
"teiknsetjingsteikn ordgrensene. Denne lista med unntak vert i staden rekna "
"som del av ordet."

#: src/dev.itznoel.Bevy.gschema.xml.in:167
msgid "Scrollbar Policy"
msgstr "Rullefeltpolitikk"

#: src/dev.itznoel.Bevy.gschema.xml.in:168
msgid "If scrollbars should be displayed"
msgstr "Om rullefelt skal visast"

#: src/dev.itznoel.Bevy.gschema.xml.in:177
msgid "Text Blink Mode"
msgstr "Blinkemodus for tekst"

#: src/dev.itznoel.Bevy.gschema.xml.in:178
msgid "When text blinking is allowed"
msgstr "Når tekstblinking er tillate"

#: src/dev.itznoel.Bevy.gschema.xml.in:183
msgid "Interface Style"
msgstr "Grensesnittstil"

#: src/dev.itznoel.Bevy.gschema.xml.in:184
msgid "If light or dark interface style should be used"
msgstr "Om lyst eller mørkt grensesnitt skal brukast"

#: src/dev.itznoel.Bevy.gschema.xml.in:189 src/bevy-preferences-window.ui:351
msgid "Restore Session"
msgstr "Gjenopprett økt"

#: src/dev.itznoel.Bevy.gschema.xml.in:190
msgid "Restore tabs from previous session when starting Bevy"
msgstr "Gjenopprett faner frå førre økt når Bevy startar"

#: src/dev.itznoel.Bevy.gschema.xml.in:195 src/bevy-preferences-window.ui:357
msgid "Restore Window Size"
msgstr "Gjenopprett vindaugsstorleik"

#: src/dev.itznoel.Bevy.gschema.xml.in:196
msgid "Restore the previous window size when creating new windows"
msgstr "Gjenopprett førre vindaugsstorleik når nye vindauge vert oppretta"

#: src/dev.itznoel.Bevy.gschema.xml.in:206
msgid "Default Column Size"
msgstr "Standard kolonnestorleik"

#: src/dev.itznoel.Bevy.gschema.xml.in:207
#: src/dev.itznoel.Bevy.gschema.xml.in:214
msgid "Default window size when restore-window-size is not true."
msgstr ""
"Standard vindaugsstorleik når gjenopprett-vindaugsstorleik ikkje er valt."

#: src/dev.itznoel.Bevy.gschema.xml.in:213
msgid "Default Row Size"
msgstr "Standard radstorleik"

#: src/dev.itznoel.Bevy.gschema.xml.in:219
msgid "Toast on Copy Clipboard"
msgstr "Varsel ved kopiering til utklippstavla"

#: src/dev.itznoel.Bevy.gschema.xml.in:220
msgid "Show the user when text has copied to the clipboard."
msgstr "Vis brukaren når tekst er kopiert til utklippstavla."

#: src/dev.itznoel.Bevy.gschema.xml.in:225
msgid "Enable Accessibility"
msgstr "Slå på tilgjenge"

#: src/dev.itznoel.Bevy.gschema.xml.in:226
msgid ""
"Currently experimental feature to send accessibility information to screen "
"readers."
msgstr ""
"For tida ein eksperimentell funksjon for å senda tilgjengeinformasjon til "
"skjermlesarar."

#: src/dev.itznoel.Bevy.gschema.xml.in:231
msgid "Enable zoom on scroll holding the control key"
msgstr ""

#: src/dev.itznoel.Bevy.gschema.xml.in:232
msgid ""
"Enable to adjust the zoom level on scroll scroll while holding the control "
"key."
msgstr ""

#: src/dev.itznoel.Bevy.gschema.xml.in:237
msgid "Disable Padding around Terminal Emulator"
msgstr "Slå av marg rundt terminalemulatoren"

#: src/dev.itznoel.Bevy.gschema.xml.in:238
msgid ""
"Do not pad around the terminal emulator widget. Setting to true may have "
"significant performance impacts."
msgstr ""
"Ikkje legg til marg rundt terminalemulatoren. Å setja dette til sann kan ha "
"stor innverknad på ytinga."

#: src/dev.itznoel.Bevy.gschema.xml.in:243
msgid "Prompt when active tab is closed"
msgstr "Spør når aktiv fane vert lukka"

#: src/dev.itznoel.Bevy.gschema.xml.in:244
msgid ""
"If a tab (or window) is closed with active foreground processes, prompt the "
"user for confirmation."
msgstr ""
"Dersom ei fane (eller eit vindauge) vert lukka med aktive "
"forgrunnsprosessar, be brukaren stadfesta."

#. Translators: OSC stands for "Operating System Command" and is referencing in-band escape sequences from the child process to set the title
#: src/dev.itznoel.Bevy.gschema.xml.in:250
msgid "Ignore OSC Title"
msgstr "Ignorer OSC-tittel"

#: src/dev.itznoel.Bevy.gschema.xml.in:251
msgid "If OSC title should be ignored in tab titles."
msgstr "Om OSC-tittel skal ignorerast i fanetitlar."

#: src/dev.itznoel.Bevy.gschema.xml.in:256
msgid "Inhibit Logout"
msgstr "Hindra utlogging"

#: src/dev.itznoel.Bevy.gschema.xml.in:257
msgid "Inhibit desktop logout when a foreground process is running in a tab."
msgstr ""
"Hindra utlogging frå skrivebordet når ein forgrunnsprosess køyrer i ei fane."

#: src/dev.itznoel.Bevy.gschema.xml.in:266
msgid "Label"
msgstr "Merkelapp"

#: src/dev.itznoel.Bevy.gschema.xml.in:267
msgid "The label for the profile"
msgstr "Merkelappen for profilen"

#: src/dev.itznoel.Bevy.gschema.xml.in:272
msgid "Login Shell"
msgstr "Innloggingsskal"

#: src/dev.itznoel.Bevy.gschema.xml.in:273
msgid "Use a login shell"
msgstr "Bruk ein innloggingsskal"

#: src/dev.itznoel.Bevy.gschema.xml.in:278 src/bevy-preferences-window.ui:482
#: src/bevy-profile-editor.ui:333
msgid "Limit Scrollback"
msgstr "Avgrens tilbakeskrolling"

#: src/dev.itznoel.Bevy.gschema.xml.in:279
msgid "Limit the number of lines to keep for scrollback"
msgstr "Avgrens talet på linjer som skal lagrast for tilbakeskrolling"

#: src/dev.itznoel.Bevy.gschema.xml.in:285 src/bevy-preferences-window.ui:491
#: src/bevy-profile-editor.ui:342
msgid "Scrollback Lines"
msgstr "Tilbakeskrollingslinjer"

#: src/dev.itznoel.Bevy.gschema.xml.in:286
msgid "The number of lines to keep in the scrollback, zero for no scrollback"
msgstr ""
"Talet på linjer som skal lagrast i tilbakeskrollinga, null for ingen "
"tilbakeskrolling"

#: src/dev.itznoel.Bevy.gschema.xml.in:291 src/bevy-preferences-window.ui:472
#: src/bevy-profile-editor.ui:323
msgid "Scroll on Output"
msgstr "Rull ved utdata"

#: src/dev.itznoel.Bevy.gschema.xml.in:292
msgid "Scroll to the bottom upon new output"
msgstr "Rull til botnen ved nye utdata"

#: src/dev.itznoel.Bevy.gschema.xml.in:297 src/bevy-preferences-window.ui:466
#: src/bevy-profile-editor.ui:317
msgid "Scroll on Keystroke"
msgstr "Rull ved tastetrykk"

#: src/dev.itznoel.Bevy.gschema.xml.in:298
msgid "Scroll to the bottom upon user keystroke"
msgstr "Rull til botnen ved tastetrykk frå brukaren"

#: src/dev.itznoel.Bevy.gschema.xml.in:303 src/bevy-profile-editor.ui:187
msgid "Use Custom Command"
msgstr "Bruk tilpassa kommando"

#: src/dev.itznoel.Bevy.gschema.xml.in:304
msgid "If a custom command should be used"
msgstr "Om ein tilpassa kommando skal brukast"

#: src/dev.itznoel.Bevy.gschema.xml.in:309
msgid "Use Proxy"
msgstr "Bruk mellomtenar"

#: src/dev.itznoel.Bevy.gschema.xml.in:310
msgid "Apply proxy settings from the host in the container"
msgstr "Bruk mellomtenarinnstillingane frå verten i containeren"

#: src/dev.itznoel.Bevy.gschema.xml.in:315 src/bevy-profile-editor.ui:192
msgid "Custom Command"
msgstr "Tilpassa kommando"

#: src/dev.itznoel.Bevy.gschema.xml.in:316
msgid "A custom command for the shell"
msgstr "Ein tilpassa kommando for skallet"

#: src/dev.itznoel.Bevy.gschema.xml.in:321 src/bevy-profile-editor.ui:211
msgid "Default Container"
msgstr "Standardcontainer"

#: src/dev.itznoel.Bevy.gschema.xml.in:322
msgid "The default container to run the command in"
msgstr "Standardcontaineren kommandoen skal køyrast i"

#: src/dev.itznoel.Bevy.gschema.xml.in:327 src/bevy-profile-editor.ui:220
msgid "Preserve Container"
msgstr "Behald container"

#: src/dev.itznoel.Bevy.gschema.xml.in:328
msgid "Preserve the active container when creating new tabs and windows"
msgstr "Behald den aktive containeren når nye faner og vindauge vert oppretta"

#: src/dev.itznoel.Bevy.gschema.xml.in:333 src/bevy-preferences-window.ui:551
#: src/bevy-profile-editor.ui:281
msgid "Exit Action"
msgstr "Handling ved avslutting"

#: src/dev.itznoel.Bevy.gschema.xml.in:334
msgid "The action to take when the shell exits"
msgstr "Handlinga som skal utførast når skallet avsluttar"

#: src/dev.itznoel.Bevy.gschema.xml.in:339
msgid "Preserve Directory"
msgstr "Behald katalog"

#: src/dev.itznoel.Bevy.gschema.xml.in:340
msgid "If the directory should be preserved for new terminals"
msgstr "Om katalogen skal bevarast for nye terminalar"

#: src/dev.itznoel.Bevy.gschema.xml.in:345 src/bevy-inspector.ui:102
#: src/bevy-preferences-window.ui:40 src/bevy-profile-editor.ui:65
msgid "Palette"
msgstr "Palett"

#: src/dev.itznoel.Bevy.gschema.xml.in:346
msgid "The color palette to use for the profile, by name"
msgstr "Fargepaletten som skal brukast for profilen, etter namn"

#: src/dev.itznoel.Bevy.gschema.xml.in:352
msgid "Opacity"
msgstr "Gjennomsikt"

#: src/dev.itznoel.Bevy.gschema.xml.in:353
msgid "The opacity of the palette background"
msgstr "Gjennomsikta til palettbakgrunnen"

#: src/dev.itznoel.Bevy.gschema.xml.in:358
msgid "Bold is Bright"
msgstr "Feit er lys"

#: src/dev.itznoel.Bevy.gschema.xml.in:359
msgid ""
"Setting bold on one of the lower 8 colors in the palette will use bright "
"variant (upper 8 colors)"
msgstr ""
"Å setje feit skrift på ein av dei nedre 8 fargane i paletten vil bruke den "
"lysare varianten (øvre 8 fargar)"

#: src/dev.itznoel.Bevy.gschema.xml.in:365 src/bevy-preferences-window.ui:175
#: src/bevy-profile-editor.ui:143
msgid "Line Spacing"
msgstr "Linjeavstand"

#: src/dev.itznoel.Bevy.gschema.xml.in:366
msgid "The terminal’s cell height scale"
msgstr "Skalering av cellehøgd i terminalen"

#: src/dev.itznoel.Bevy.gschema.xml.in:372 src/bevy-preferences-window.ui:189
#: src/bevy-profile-editor.ui:157
msgid "Column Spacing"
msgstr "Kolonneavstand"

#: src/dev.itznoel.Bevy.gschema.xml.in:373
msgid "The terminal’s cell width scale"
msgstr "Skalering av cellebreidd i terminalen"

#: src/dev.itznoel.Bevy.gschema.xml.in:378
msgid "CJK Ambiguous Width"
msgstr "CJK tvetydig breidd"

#: src/dev.itznoel.Bevy.gschema.xml.in:379
msgid "The size to apply to ambiguous width characters"
msgstr "Storleik som skal brukast på teikn med tvetydig breidd"

#: src/dev.itznoel.Bevy.gschema.xml.in:384
#: src/dev.itznoel.Bevy.gschema.xml.in:390
msgid "Backspace Binding"
msgstr "Tilordning av bakoversteg"

#: src/dev.itznoel.Bevy.gschema.xml.in:385
#: src/dev.itznoel.Bevy.gschema.xml.in:391
msgid "What to send to the PTY when a backspace is entered"
msgstr "Kva som skal sendast til PTY når bakoversteg blir trykt"

#: src/dev.itznoel.Bevy.gschema.xml.in:396 src/bevy-preferences-window.ui:634
#: src/bevy-profile-editor.ui:409
msgid "Custom Links"
msgstr "Tilpassa lenkjer"

#: src/dev.itznoel.Bevy.gschema.xml.in:397
msgid ""
"A list of custom hyperlinks, each defined by a regular expression matching "
"the text, and a replacement pattern"
