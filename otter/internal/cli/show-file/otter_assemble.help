{2}╭──────────────────────────────────────────────────────────╮{R}
{2}│{R}{1}⦿ Manage otter containers using manifest files            {R}{2}│{R}
{2}├──────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                                  {2}│{R}
{2}│{R}  {5}otter dmf      <create|remove> [options]{R}                {2}│{R}
{2}│{R}  {5}otter assemble <create|remove> [options]{R}                {2}│{R}
{2}├──────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                                               {2}│{R}
{2}│{R}  {5}otter dmf rm my-box --file /path/to/file.toml{R}           {2}│{R}
{2}│{R}  {5}otter dmf mk --replace --file /path/to/file.toml{R}        {2}│{R}
{2}│{R}  {5}otter assemble create -R --file /path/to/file.toml{R}      {2}│{R}
{2}│{R}  {5}otter assemble remove my-box --file /path/to/file.toml{R}  {2}│{R}
{2}├──────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Commands:{R}                                               {2}│{R}
{2}│{R}  {0}create{R}   {2}┆{R} {0}mk{R} {5}Create boxes from manifest{R}                {2}│{R}
{2}│{R}  {0}remove{R}   {2}┆{R} {0}rm{R} {5}Remove boxes from manifest{R}                {2}│{R}
{2}├───────────┴──────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                                                {2}│{R}
{2}│{R} {4}--file{R}    {2}┆{R} {4}-f{R} {5}Manifest path or URL{R}                      {2}│{R}
{2}│{R} {4}--replace{R} {2}┆{R} {4}-R{R} {5}Replace matching containers{R}               {2}│{R}
{2}├───────────┴──────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                                                 {2}│{R}
{2}│{R} {4}--help{R}    {2}┆{R} {4}-h{R} {5}Show this help message{R}                    {2}│{R}
{2}├──────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Notes:{R}                                                  {2}│{R}
{2}│{R}{4}--file{R}{5}  Required. The positional argument is the box{R}      {2}│{R}
{2}│{R}{5}        name to target, not the manifest path.{R}            {2}│{R}
{2}├──────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ See also:{R}                                               {2}│{R}
{2}│{R}{5}See Manifests in otter documentation.{R}                     {2}│{R}
{2}│{R}{5}See assemble in otter documentation.{R}                      {2}│{R}
{2}╰──────────────────────────────────────────────────────────╯{R}
