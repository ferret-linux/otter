{2}╭────────────────────────────────────────────╮{R}
{2}│{R}{1}⦿ Pause an otter managed running container{R}  {2}│{R}
{2}├────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                    {2}│{R}
{2}│{R}  {5}otter zz    [options] [container...]{R}      {2}│{R}
{2}│{R}  {5}otter pause [options] [container...]{R}      {2}│{R}
{2}├────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                                 {2}│{R}
{2}│{R}  {5}otter zz --all{R}                            {2}│{R}
{2}│{R}  {5}otter zz my-box{R}                           {2}│{R}
{2}│{R}  {5}otter pause --all --root{R}                  {2}│{R}
{2}│{R}  {5}otter pause ubuntu,fedora{R}                 {2}│{R}
{2}├────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                                  {2}│{R}
{2}│{R} {4}--all{R}     {2}┆{R} {4}-a{R}  {5}Use all containers{R}         {2}│{R}
{2}│{R} {4}--root{R}    {2}┆{R} {4}-r{R}  {5}Use rootful containers{R}     {2}│{R}
{2}├───────────┴────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                                   {2}│{R}
{2}│{R} {4}--help{R}    {2}┆{R} {4}-h{R}  {5}Show this help message{R}     {2}│{R}
{2}├───────────┴────────────────────────────────┤{R}
{2}│{R}{3}▸ Notes:{R}                                    {2}│{R}
{2}│{R}{5}Paused containers are frozen in memory.{R}     {2}│{R}
{2}│{R}{5}Use 'otter start' to resume.{R}                {2}│{R}
{2}│{R}{4}--root{R}{5}  Prefer '--root' over sudo.{R}          {2}│{R}
{2}│{R}{5}        Set 'preferences.sudo-program'{R}      {2}│{R}
{2}│{R}{5}        for another escalator.{R}              {2}│{R}
{2}├────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ See also:{R}                                 {2}│{R}
{2}│{R}{5}See "pause" in documentation.{R}               {2}│{R}
{2}│{R}{5}See "start" in documentation.{R}               {2}│{R}
{2}│{R}{5}Run 'otter docs' to browse the docs offline.{R}{2}│{R}
{2}╰────────────────────────────────────────────╯{R}
