{2}╭────────────────────────────────────────────╮{R}
{2}│{R}{1}⦿ Generate desktop entry for containers{R}     {2}│{R}
{2}├────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                    {2}│{R}
{2}│{R}  {5}otter pin            [options] [name...]{R}  {2}│{R}
{2}│{R}  {5}otter generate-entry [options] [name...]{R}  {2}│{R}
{2}├────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                                 {2}│{R}
{2}│{R}  {5}otter pin --all{R}                           {2}│{R}
{2}│{R}  {5}otter pin my-box -i /path/to/icon{R}         {2}│{R}
{2}│{R}  {5}otter generate-entry --all --root{R}         {2}│{R}
{2}│{R}  {5}otter generate-entry debian --delete{R}      {2}│{R}
{2}├────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                                  {2}│{R}
{2}│{R} {4}--all{R}    {2}┆{R} {4}-a{R}  {5}Use all containers{R}          {2}│{R}
{2}│{R} {4}--root{R}   {2}┆{R} {4}-r{R}  {5}Use rootful containers{R}      {2}│{R}
{2}│{R} {4}--icon{R}   {2}┆{R} {4}-i{R}  {5}Custom icon path{R}            {2}│{R}
{2}│{R} {4}--delete{R} {2}┆{R} {4}-d{R}  {5}Delete the desktop entry{R}    {2}│{R}
{2}├──────────┴─────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                                   {2}│{R}
{2}│{R} {4}--help{R}    {2}┆{R} {4}-h{R}  {5}Show this help message{R}     {2}│{R}
{2}├───────────┴────────────────────────────────┤{R}
{2}│{R}{3}▸ Notes:{R}                                    {2}│{R}
{2}│{R}{5}--icon is ignored when --all is used.{R}       {2}│{R}
{2}│{R}{5}Creates a launcher that opens the container{R} {2}│{R}
{2}│{R}{5}in your terminal.{R}                           {2}│{R}
{2}│{R}{5}Entries are saved to:{R}                       {2}│{R}
{2}│{R}{5}~/.local/share/applications/*{R}               {2}│{R}
{2}├────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ See also:{R}                                 {2}│{R}
{2}│{R}{5}See "generate-entry" in documentation.{R}      {2}│{R}
{2}│{R}{5}Run 'otter docs' to browse the docs offline.{R}{2}│{R}
{2}╰────────────────────────────────────────────╯{R}
