{2}│{R}{1}⦿ List otter images available in the registry          {R}{2}│{R}
{2}├───────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                               {2}│{R}
{2}│{R}  {5}otter reg ls        [options]{R}                        {2}│{R}
{2}│{R}  {5}otter registry list [options]{R}                        {2}│{R}
{2}├───────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                                            {2}│{R}
{2}│{R}  {5}otter reg ls{R}                                         {2}│{R}
{2}│{R}  {5}otter reg ls --all{R}                                   {2}│{R}
{2}│{R}  {5}otter registry list -j{R}                               {2}│{R}
{2}│{R}  {5}otter registry list --all{R}                            {2}│{R}
{2}├───────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                                             {2}│{R}
{2}│{R} {4}--all{R}     {2}┆{R} {4}-a{R}  {5}Include disabled images{R}               {2}│{R}
{2}│{R} {4}--json{R}    {2}┆{R} {4}-j{R}  {5}Output as JSON{R}                        {2}│{R}
