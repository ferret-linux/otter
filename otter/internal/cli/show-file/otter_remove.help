{2}╭─────────────────────────────────────────────────────────────╮{R}
{2}│{R}{1}⦿ Remove otter managed container environments                {R}{2}│{R}
{2}├─────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                                     {2}│{R}
{2}│{R}  {5}otter rm     [options] [container...]{R}                      {2}│{R}
{2}│{R}  {5}otter remove [options] [container...]{R}                      {2}│{R}
{2}├─────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                                                  {2}│{R}
{2}│{R}  {5}otter rm --all --force{R}                                     {2}│{R}
{2}│{R}  {5}otter rm --force my-box{R}                                    {2}│{R}
{2}│{R}  {5}otter remove my-box my-box2,my-box3{R}                        {2}│{R}
{2}│{R}  {5}otter remove --all --root --force --rm-home{R}                {2}│{R}
{2}├─────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                                                   {2}│{R}
{2}│{R}{4} --all         {R}{2}┆{R}{4} -a  {R}{5}Use all containers{R}                      {2}│{R}
{2}│{R}{4} --root        {R}{2}┆{R}{4} -r  {R}{5}Use rootful containers{R}                  {2}│{R}
{2}│{R}{4} --force       {R}{2}┆{R}{4} -f  {R}{5}Force the operation{R}                     {2}│{R}
{2}│{R}{4} --prune       {R}{2}┆{R}{4}     {R}{5}Remove exports and leftovers{R}            {2}│{R}
{2}│{R}{4} --rm-home     {R}{2}┆{R}{4} -H  {R}{5}Remove custom home directory{R}            {2}│{R}
{2}│{R}{4} --bypass-lock {R}{2}┆{R}{4} -B  {R}{5}Remove even when locked{R}                 {2}│{R}
{2}├─────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                                                    {2}│{R}
{2}│{R} {4}--help{R}    {2}┆{R} {4}-h{R}  {5}Show this help message{R}                      {2}│{R}
{2}├───────────┴─────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Notes:{R}                                                     {2}│{R}
{2}│{R}{4}--root{R}{5}  Prefer '--root' over 'sudo otter'.{R}                   {2}│{R}
{2}│{R}{5}        Use 'preferences.sudo-program' for a{R}                 {2}│{R}
{2}│{R}{5}        different escalator.{R}                                 {2}│{R}
{2}│{R}{5}Locked containers are skipped with --all; named{R}              {2}│{R}
{2}│{R}{5}locked containers log an error.{R}                              {2}│{R}
{2}│{R}{5}Use 'otter unlock' first, or pass --bypass-lock.{R}             {2}│{R}
{2}│{R}{5}--prune also removes exports, backups, and temp files.{R}       {2}│{R}
{2}├─────────────────────────────────────────────────────────────┤{R}
{2}│{R}{3}▸ See also:{R}                                                  {2}│{R}
{2}│{R}{5}See unlock and cleanup in otter documentation.{R}               {2}│{R}
{2}╰─────────────────────────────────────────────────────────────╯{R}
