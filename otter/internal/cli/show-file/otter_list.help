{2}│{R}{1}⦿ List all otter managed containers{R}     {2}│{R}
{2}├────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Usage:{R}                                {2}│{R}
{2}│{R}  {5}otter ls   [options]{R}                  {2}│{R}
{2}│{R}  {5}otter list [options]{R}                  {2}│{R}
{2}├────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Examples:{R}                             {2}│{R}
{2}│{R}  {5}otter ls --root{R}                       {2}│{R}
{2}│{R}  {5}NO_COLOR=1 otter ls{R}                   {2}│{R}
{2}│{R}  {5}otter list --root --json{R}              {2}│{R}
{2}│{R}  {5}NO_COLOR=1 otter list --root{R}          {2}│{R}
{2}├────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Options:{R}                              {2}│{R}
{2}│{R} {4}--root{R}     {2}┆{R} {4}-r{R}  {5}Use rootful containers{R}{2}│{R}
{2}│{R} {4}--json{R}     {2}┆{R} {4}-j{R}  {5}Output as JSON{R}        {2}│{R}
{2}├────────────────────────────────────────┤{R}
{2}│{R}{3}▸ Extras:{R}                               {2}│{R}
{2}│{R} {4}--help{R}    {2}┆{R} {4}-h{R}  {5}Show this help message{R} {2}│{R}
{2}├───────────┴────────────────────────────┤{R}
{2}│{R}{3}▸ Notes:{R}                                {2}│{R}
{2}│{R}{4}--root{R}{5}  Prefer '--root' over sudo.{R}      {2}│{R}
